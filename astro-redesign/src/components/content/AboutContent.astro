---
import { Icon } from 'astro-icon/components';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang as any);

const highlights = [
  {
    icon: 'ph:paint-brush-bold',
    title: 'UI Design',
    desc: 'Interfaces com atenção obsessiva aos detalhes, tipografia e espaçamento.',
  },
  {
    icon: 'ph:code-bold',
    title: 'Frontend',
    desc: 'Código limpo com Astro, React, e animações fluidas.',
  },
  {
    icon: 'ph:lightning-bold',
    title: 'Performance',
    desc: 'Otimização agressiva. Core Web Vitals sempre no verde.',
  },
];

const values = [
  'Craft over speed',
  'Details matter',
  'Less is more',
  'Ship & iterate',
];
---

<div class="space-y-10">
  
  <!-- Intro Section -->
  <section class="space-y-4">
    <p class="text-lg md:text-xl leading-relaxed text-brand-dark/80 dark:text-brand-light/80">
      Sou um <strong class="text-brand-purple">Design Engineer</strong> focado na interseção entre 
      design visual e código frontend. Acredito que os melhores produtos nascem quando design e 
      desenvolvimento trabalham em simbiose.
    </p>
    <p class="text-base leading-relaxed text-brand-dark/60 dark:text-brand-light/60">
      Atualmente cursando Design de Produto na UFSC, com background técnico em informática. 
      Essa combinação me permite pensar em sistemas completos — do wireframe ao deploy.
    </p>
  </section>

  <!-- Highlights Grid -->
  <section class="grid grid-cols-1 md:grid-cols-3 gap-4">
    {highlights.map((item) => (
      <div class="p-5 rounded-2xl border border-brand-dark/5 dark:border-brand-light/5 bg-white/30 dark:bg-white/5 hover:border-brand-purple/30 transition-colors group">
        <div class="w-10 h-10 rounded-xl bg-brand-purple/10 flex items-center justify-center mb-4 group-hover:bg-brand-purple/20 transition-colors">
          <Icon name={item.icon} class="w-5 h-5 text-brand-purple" />
        </div>
        <h3 class="font-bold text-base text-brand-dark dark:text-brand-light mb-2">
          {item.title}
        </h3>
        <p class="text-sm text-brand-dark/60 dark:text-brand-light/60 leading-relaxed">
          {item.desc}
        </p>
      </div>
    ))}
  </section>

  <!-- Values -->
  <section class="pt-6 border-t border-brand-dark/5 dark:border-brand-light/5">
    <h3 class="text-xs font-mono uppercase tracking-widest text-brand-dark/40 dark:text-brand-light/40 mb-4">
      Princípios
    </h3>
    <div class="flex flex-wrap gap-3">
      {values.map((value) => (
        <span class="px-4 py-2 rounded-full border border-brand-dark/10 dark:border-brand-light/10 text-sm font-medium text-brand-dark/70 dark:text-brand-light/70 bg-white/50 dark:bg-black/20">
          {value}
        </span>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="pt-6 flex flex-col sm:flex-row gap-4">
    <a 
      href="mailto:contato@vitorhugocunha.com" 
      class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-brand-purple text-white font-medium hover:bg-brand-purple/90 transition-colors"
    >
      <Icon name="ph:envelope-simple-bold" class="w-4 h-4" />
      <span>Entre em contato</span>
    </a>
    <a 
      href="/cv-vitor-hugo-cunha.pdf" 
      target="_blank"
      class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full border border-brand-dark/10 dark:border-brand-light/10 text-brand-dark dark:text-brand-light font-medium hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
    >
      <Icon name="ph:file-pdf-bold" class="w-4 h-4" />
      <span>Download CV</span>
    </a>
  </section>

</div>
