---
import { Icon } from 'astro-icon/components';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang as any);

// Project data - could be moved to a separate data file
type ProjectStatus = 'live' | 'in-progress' | 'planned';
type ProjectColor = 'purple' | 'terracotta' | 'green';

interface Project {
  id: string;
  title: string;
  tagline: string;
  desc: string;
  tags: string[];
  status: ProjectStatus;
  color: ProjectColor;
  icon: string;
}

const projects: Project[] = [
  {
    id: 'riji',
    title: '日记 Riji',
    tagline: 'Private Journal App',
    desc: 'Diário digital offline-first com sincronização via Firebase. Suporta modo visitante e autenticação completa.',
    tags: ['Astro', 'Firebase', 'IndexedDB', 'PWA'],
    status: 'in-progress',
    color: 'purple',
    icon: 'ph:notebook-bold',
  },
  {
    id: 'coisas-bonitas',
    title: 'Coisas Bonitas',
    tagline: 'Audio/Visual Refuge',
    desc: 'Web radio ambiente com curadoria pessoal. Player customizado com visualização generativa.',
    tags: ['Web Audio API', 'Canvas', 'Astro'],
    status: 'planned',
    color: 'terracotta',
    icon: 'ph:radio-bold',
  },
  {
    id: 'noise-mixer',
    title: 'Noise Mixer',
    tagline: 'Focus Sound Tool',
    desc: 'Mixer de sons ambiente para foco e concentração. UI com controles SVG customizados.',
    tags: ['Web Audio API', 'SVG', 'TypeScript'],
    status: 'planned',
    color: 'green',
    icon: 'ph:waveform-bold',
  },
  {
    id: 'dither-tool',
    title: 'Dither Studio',
    tagline: 'Image Processing',
    desc: 'Ferramenta de dithering de imagens com processamento em Rust/WASM para performance máxima.',
    tags: ['Rust', 'WebAssembly', 'Canvas'],
    status: 'planned',
    color: 'purple',
    icon: 'ph:image-bold',
  },
];

const statusLabels: Record<ProjectStatus, { label: string; class: string }> = {
  'live': { label: 'Live', class: 'bg-green-500/20 text-green-600 dark:text-green-400' },
  'in-progress': { label: 'Em desenvolvimento', class: 'bg-yellow-500/20 text-yellow-600 dark:text-yellow-400' },
  'planned': { label: 'Planejado', class: 'bg-brand-purple/20 text-brand-purple' },
};

const colorClasses: Record<ProjectColor, string> = {
  purple: 'from-brand-purple/20',
  terracotta: 'from-brand-terracotta/20',
  green: 'from-brand-green/20',
};
---

<div class="space-y-6">
  
  <!-- Projects Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {projects.map((project) => (
      <article 
        class="group relative p-6 rounded-2xl border border-brand-dark/5 dark:border-brand-light/5 bg-white/30 dark:bg-white/5 hover:border-brand-purple/30 transition-all duration-300 overflow-hidden"
      >
        <!-- Gradient accent -->
        <div class={`absolute top-0 left-0 w-full h-1 bg-gradient-to-r ${colorClasses[project.color]} to-transparent opacity-0 group-hover:opacity-100 transition-opacity`}></div>
        
        <!-- Header -->
        <div class="flex items-start justify-between mb-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-brand-dark/5 dark:bg-white/10 flex items-center justify-center">
              <Icon name={project.icon} class="w-5 h-5 text-brand-dark/60 dark:text-brand-light/60" />
            </div>
            <div>
              <h3 class="font-bold text-base text-brand-dark dark:text-brand-light group-hover:text-brand-purple transition-colors">
                {project.title}
              </h3>
              <span class="text-xs text-brand-dark/50 dark:text-brand-light/50">
                {project.tagline}
              </span>
            </div>
          </div>
          
          <span class={`px-2 py-1 rounded-full text-[10px] font-bold uppercase tracking-wide ${statusLabels[project.status].class}`}>
            {statusLabels[project.status].label}
          </span>
        </div>
        
        <!-- Description -->
        <p class="text-sm text-brand-dark/60 dark:text-brand-light/60 leading-relaxed mb-4">
          {project.desc}
        </p>
        
        <!-- Tags -->
        <div class="flex flex-wrap gap-2">
          {project.tags.map((tag) => (
            <span class="text-[10px] uppercase tracking-wider font-mono text-brand-dark/40 dark:text-brand-light/40 bg-black/5 dark:bg-white/5 px-2 py-1 rounded">
              {tag}
            </span>
          ))}
        </div>
        
        <!-- Hover arrow -->
        <div class="absolute bottom-4 right-4 w-8 h-8 rounded-full bg-brand-purple/10 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 translate-x-2 group-hover:translate-x-0">
          <Icon name="ph:arrow-right-bold" class="w-4 h-4 text-brand-purple" />
        </div>
      </article>
    ))}
  </div>

  <!-- Coming Soon Note -->
  <div class="text-center pt-4">
    <p class="text-sm text-brand-dark/40 dark:text-brand-light/40">
      Mais projetos em breve. <a href="https://github.com/rugo-cafe" target="_blank" class="text-brand-purple hover:underline">Ver GitHub →</a>
    </p>
  </div>

</div>
