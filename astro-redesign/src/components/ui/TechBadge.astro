---
import { Icon } from 'astro-icon/components';

interface Props {
  icon: string;
  label: string;
  class?: string;
}

const { icon, label, class: className } = Astro.props;
---

<div 
  class:list={[
    "flex items-center gap-1.5 px-3 py-1.5 rounded-full",
    "border border-black/5 dark:border-white/10",
    "bg-black/5 dark:bg-white/5",
    "text-xs font-medium text-brand-dark/80 dark:text-brand-light/80",
    "hover:bg-black/10 dark:hover:bg-white/10",
    "hover:border-black/10 dark:hover:border-white/20",
    "transition-all duration-200 cursor-default",
    "select-none",
    className
  ]}
>
  <Icon name={icon} class="w-3.5 h-3.5 shrink-0" />
  <span class="lowercase">{label}</span>
</div>
