---
/**
 * Modal Component
 * Native <dialog> based modal with glassmorphism backdrop
 * Accessible and keyboard-friendly
 */

interface Props {
  id: string;
  title?: string;
  size?: 'sm' | 'md' | 'lg' | 'xl' | 'full';
  class?: string;
}

const { id, title, size = 'lg', class: className } = Astro.props;

const sizeClasses = {
  sm: 'max-w-md',
  md: 'max-w-xl',
  lg: 'max-w-3xl',
  xl: 'max-w-5xl',
  full: 'max-w-[95vw] max-h-[95vh]',
};
---

<dialog 
  id={id}
  class:list={[
    "modal-dialog",
    "fixed inset-0 m-auto p-0",
    "w-[90vw] max-h-[85vh]",
    sizeClasses[size],
    "bg-white/80 dark:bg-brand-dark/90",
    "backdrop-blur-2xl",
    "border border-white/30 dark:border-white/10",
    "rounded-3xl shadow-2xl shadow-black/10",
    "overflow-hidden",
    "opacity-0 scale-95 translate-y-4",
    "transition-all duration-300 ease-out",
    "open:opacity-100 open:scale-100 open:translate-y-0",
    className
  ]}
>
  <!-- Modal Header -->
  <header class="sticky top-0 z-10 flex items-center justify-between px-6 py-4 md:px-8 md:py-5 border-b border-brand-dark/5 dark:border-brand-light/5 bg-white/50 dark:bg-black/20 backdrop-blur-xl">
    {title && (
      <h2 class="font-display font-bold text-xl md:text-2xl text-brand-dark dark:text-brand-light tracking-tight lowercase">
        {title}<span class="text-brand-purple">.</span>
      </h2>
    )}
    <slot name="header" />
    
    <button 
      type="button"
      class="modal-close-btn flex items-center justify-center w-10 h-10 rounded-full bg-black/5 dark:bg-white/10 hover:bg-black/10 dark:hover:bg-white/20 transition-colors cursor-pointer group"
      aria-label="Fechar modal"
    >
      <svg class="w-5 h-5 text-brand-dark/60 dark:text-brand-light/60 group-hover:text-brand-dark dark:group-hover:text-brand-light transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </header>

  <!-- Modal Content -->
  <div class="modal-content overflow-y-auto px-6 py-6 md:px-8 md:py-8" style="max-height: calc(85vh - 80px);">
    <slot />
  </div>

  <!-- Modal Footer (optional) -->
  <slot name="footer" />
</dialog>

<!-- Backdrop -->
<div 
  id={`${id}-backdrop`}
  class="modal-backdrop fixed inset-0 z-40 bg-brand-dark/40 dark:bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
  aria-hidden="true"
></div>

<script define:vars={{ id }}>
  document.addEventListener('astro:page-load', () => {
    const dialog = document.getElementById(id);
    const backdrop = document.getElementById(`${id}-backdrop`);
    const closeBtn = dialog?.querySelector('.modal-close-btn');

    if (!dialog || !backdrop) return;

    // Open modal function
    window[`open${id.charAt(0).toUpperCase() + id.slice(1)}Modal`] = () => {
      dialog.showModal();
      backdrop.classList.remove('opacity-0', 'pointer-events-none');
      backdrop.classList.add('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = 'hidden';
    };

    // Close modal function
    window[`close${id.charAt(0).toUpperCase() + id.slice(1)}Modal`] = () => {
      dialog.close();
      backdrop.classList.add('opacity-0', 'pointer-events-none');
      backdrop.classList.remove('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = '';
    };

    // Close button
    closeBtn?.addEventListener('click', () => {
      window[`close${id.charAt(0).toUpperCase() + id.slice(1)}Modal`]();
    });

    // Click on backdrop to close
    backdrop.addEventListener('click', () => {
      window[`close${id.charAt(0).toUpperCase() + id.slice(1)}Modal`]();
    });

    // ESC key to close
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        e.preventDefault();
        window[`close${id.charAt(0).toUpperCase() + id.slice(1)}Modal`]();
      }
    });

    // Prevent closing when clicking inside modal
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) {
        window[`close${id.charAt(0).toUpperCase() + id.slice(1)}Modal`]();
      }
    });
  });
</script>

<style>
  /* Remove default dialog backdrop */
  dialog::backdrop {
    display: none;
  }

  /* Focus trap styling */
  dialog:focus {
    outline: none;
  }
</style>
