---
import type { ProjectEntry } from '../data/projects';
interface Props { projects: ProjectEntry[] }
const { projects } = Astro.props;
---
<aside class="project-stage" aria-hidden="true">
  <div class="stage-frame">
    <span class="stage-coordinate">fig. <span data-stage-index>01</span> / {String(projects.length).padStart(2, '0')}</span>
    <div class="stage-images">
      {projects.map((project, index) => project.resolvedImage && (
        <img
          src={project.resolvedImage}
          alt=""
          width="920"
          height="640"
          decoding="async"
          loading={index === 0 ? 'eager' : 'lazy'}
          data-stage-image={project.slug}
          class:list={{ active: index === 0 }}
        />
      ))}
    </div>
    <span class="stage-caption" data-stage-caption>{projects[0]?.title}</span>
  </div>
</aside>
<style>
  .project-stage { position: sticky; align-self: start; top: 7rem; min-width: 0; }
  .stage-frame { padding: .9rem; border: 1px solid var(--border); background: var(--surface); }
  .stage-images { aspect-ratio: 5 / 4; position: relative; overflow: hidden; background: var(--bg); }
  .stage-images img { position: absolute; inset: 0; height: 100%; width: 100%; object-fit: cover; opacity: 0; transform: translate3d(0, 8px, 0) scale(1.015); transition: opacity 480ms var(--ease-standard), transform 620ms var(--ease-out); }
  .stage-images img.active { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
  .stage-coordinate, .stage-caption { font: .72rem/1.5 var(--font-mono); color: var(--muted); display: block; }
  .stage-coordinate { padding-bottom: .8rem; }
  .stage-caption { padding-top: .8rem; }
  @media(max-width:850px){.project-stage{display:none}}
  @media(prefers-reduced-motion:reduce){.stage-images img{transition:none}}
</style>