---
import type { ProjectEntry } from '../data/projects';
interface Props { project: ProjectEntry; index: number; lang: string }
const { project, index, lang } = Astro.props;
const pt = lang === 'pt';
const route = pt ? '/projects/' + project.slug : '/' + lang + '/projects/' + project.slug;
const fragments: Record<string, { pt: [string,string]; en: [string,string]; glyph: string }> = {
  riji: { pt: ['escrita / privacidade', 'um lugar para deixar as palavras em paz.'], en: ['writing / privacy', 'a place to let the words be.'], glyph: '日' },
  'coisas-bonitas': { pt: ['rádio / arquivo', 'sons que passaram pelo ar, guardados aqui.'], en: ['radio / archive', 'sounds that passed through the air, kept here.'], glyph: '◉' },
  'ambi-mixer': { pt: ['som / interação', 'vários sons dividindo o mesmo espaço.'], en: ['sound / interaction', 'different sounds sharing the same space.'], glyph: '≈' },
  'dither-studio': { pt: ['imagem / experimento', 'uma imagem refeita ponto por ponto.'], en: ['image / experiment', 'an image rebuilt dot by dot.'], glyph: '░' }
};
const fragment = fragments[project.slug];
const [category, line] = fragment[pt ? 'pt' : 'en'];
---
<li class="plate" id={'artifact-' + project.slug} data-archive-plate={project.slug} data-kind={project.slug}>
  <a href={route} class="plate-link" aria-label={(pt ? 'abrir projeto: ' : 'open project: ') + project.title}>
    <div class="visual">
      {project.resolvedImage && <div class="visual-image" data-scroll-art><img src={project.resolvedImage} alt={project.imageAlt} width="1120" height="800" loading="lazy" decoding="async" /></div>}
      <span class="artifact-glyph" data-archive-glyph aria-hidden="true">{fragment.glyph}</span>
      <span class="visual-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
      <span class="frame-corner" aria-hidden="true">+</span>
    </div>
    <div class="caption">
      <div class="caption-title">
        <span class="caption-verb">{category} / {String(index + 1).padStart(2, '0')}</span>
        <h3>{project.title}</h3>
        <p>{line}</p>
      </div>
      <span class="arrow" aria-hidden="true">↗</span>
    </div>
  </a>
</li>
<style>
  .plate { min-width: 0; list-style: none; --wash: #dcd4cb; scroll-margin-top: 6.8rem; }
  .plate[data-kind="riji"] { grid-column: span 7; --wash: #c9ccdc; }
  .plate[data-kind="coisas-bonitas"] { grid-column: span 5; margin-top: clamp(4rem, 12vw, 11rem); --wash: #b8d6c1; }
  .plate[data-kind="ambi-mixer"] { grid-column: span 5; margin-top: -1rem; --wash: #e5d0aa; }
  .plate[data-kind="dither-studio"] { grid-column: span 7; margin-top: clamp(2rem, 8vw, 7rem); --wash: #d7bad8; }
  .plate-link { color: inherit; text-decoration: none; display: block; }
  .visual { position: relative; overflow: hidden; background: var(--wash); isolation: isolate; }
  .visual::before { content: ""; position: absolute; inset: 0; pointer-events: none; opacity: .28; background-image: repeating-linear-gradient(0deg, transparent 0 19px, #2c302b22 20px 21px); }
  .plate[data-kind="coisas-bonitas"] .visual::before { opacity: .35; background-image: repeating-radial-gradient(circle at 7% 87%, transparent 0 22px, #24463733 23px 24px); }
  .plate[data-kind="ambi-mixer"] .visual::before { opacity: .4; background-image: repeating-linear-gradient(0deg, transparent 0 28px, #76432624 29px 30px); }
  .plate[data-kind="dither-studio"] .visual::before { opacity: .25; background-image: radial-gradient(#342b442f 1px, transparent 1px); background-size: 8px 8px; }
  .visual-image { position: absolute; inset: clamp(1rem, 3vw, 2.5rem); transform: translate3d(0, var(--art-y, 0px), 0); }
  .visual img { width: 100%; height: 100%; object-fit: contain; transform: scale(.99); transition: transform 550ms var(--ease-out); }
  .plate-link:hover .visual img, .plate-link:focus-visible .visual img { transform: scale(1.035); }
  .plate[data-kind="riji"] .visual { aspect-ratio: 1.35; }
  .plate[data-kind="coisas-bonitas"] .visual { aspect-ratio: .97; }
  .plate[data-kind="ambi-mixer"] .visual { aspect-ratio: 1.19; }
  .plate[data-kind="dither-studio"] .visual { aspect-ratio: 1.51; }
  .artifact-glyph { display: grid; place-items: center; position: absolute; left: 1rem; top: 1rem; width: clamp(2.6rem, 4.3vw, 4rem); height: clamp(2.6rem, 4.3vw, 4rem); background: var(--accent-signal); color: var(--signal-ink); font: 400 clamp(1.45rem, 2.3vw, 2.2rem)/1 var(--font-mono); z-index: 1; pointer-events: none; transform: translate3d(0,var(--glyph-y,0px),0) rotate(var(--glyph-rotation,-8deg)); }
  .visual-number { position: absolute; right: 1rem; top: 1rem; z-index: 1; color: #2b2b28; font: .75rem/1.2 var(--font-mono); background: #f4f2eecc; padding: .25rem .4rem; }
  .frame-corner { position: absolute; right: .65rem; bottom: .4rem; color: #272821aa; font: 1rem/1 var(--font-mono); }
  .caption { display: flex; justify-content: space-between; gap: 1rem; padding-top: 1.1rem; }
  .caption-verb { display: block; font: .71rem/1.4 var(--font-mono); color: var(--muted); margin-bottom: .6rem; }
  h3 { font: 500 clamp(1.35rem, 2vw, 2rem)/1.15 var(--font-display); letter-spacing: -.045em; }
  p { margin-top: .45rem; color: var(--muted); line-height: 1.55; font-size: .88rem; }
  .arrow { font-size: 1.4rem; line-height: 1; transition: transform 250ms var(--ease-out); }
  .plate-link:hover .arrow, .plate-link:focus-visible .arrow { transform: translate(3px, -3px); color: var(--accent); }
  @media(max-width:780px){
    .plate, .plate[data-kind] { grid-column: span 1; margin-top: 0; }
    .plate:nth-child(even) { margin-left: min(8vw, 3rem); }
    .plate:nth-child(odd) { margin-right: min(8vw, 3rem); }
    .plate[data-kind="coisas-bonitas"] .visual { aspect-ratio: 1.23; }
  }
  @media(prefers-reduced-motion:reduce){.visual img,.arrow{transition:none;transform:none !important}.artifact-glyph,.visual-image{transform:none}}
</style>