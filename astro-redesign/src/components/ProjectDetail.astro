---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import Contact from './Contact.astro';
import { useTranslations } from '../i18n/utils';
import { getProjectEntries, type ProjectEntry, type ProjectLang } from '../data/projects';
interface Props { lang: ProjectLang; project: ProjectEntry }
const { lang, project } = Astro.props;
const t = useTranslations(lang);
const entries = getProjectEntries(lang);
const currentIndex = entries.findIndex(item => item.slug === project.slug);
const nextProject = entries[(currentIndex + 1) % entries.length];
const projectHref = (slug: string) => lang === 'pt' ? '/projects/' + slug : '/' + lang + '/projects/' + slug;
const home = lang === 'pt' ? '/' : '/en';
const pt = lang === 'pt';
---
<Layout title={project.title + ' | vitor hugo cunha'} description={project.overview} lang={pt ? 'pt-br' : 'en'}>
  <Navbar currentLang={lang} />
  <main id="main-content" class="project-detail container" data-project-type={project.slug}>
    <header class="detail-header">
      <div class="detail-meta">
        <a class="back-link" href={home + '#projects'}>← {t('project.back')}</a>
        <span class="meta-label">{String(currentIndex + 1).padStart(2, '0')} / {String(entries.length).padStart(2, '0')}</span>
      </div>
      <div class="detail-intro" data-animate>
        <span class="meta-label">{t('project.eyebrow')}</span>
        <h1>{project.title}</h1>
        <p>{project.subtitle}</p>
      </div>
    </header>
    {project.resolvedImage && (
      <figure class="detail-image" data-animate>
        <img src={project.resolvedImage} alt={project.imageAlt} width="1440" height="900" decoding="async" fetchpriority="high" />
        <figcaption class="meta-label">fig. 01 / {project.title}</figcaption>
      </figure>
    )}
    <div class="detail-grid">
      <div class="detail-story">
        <section data-animate aria-labelledby="overview-label">
          <h2 id="overview-label" class="meta-label">{t('project.overview.title')}</h2>
          <p class="detail-lead">{project.overview}</p>
        </section>
        <section data-animate aria-labelledby="challenge-label">
          <h2 id="challenge-label" class="meta-label">{t('project.challenge.title')}</h2>
          <p>{project.challengeAndSolution}</p>
        </section>
      </div>
      <aside class="detail-aside">
        <div class="detail-fact" data-animate>
          <h2 class="meta-label">{t('project.role.title')}</h2>
          <ul>{project.role.map(item => <li>{item}</li>)}</ul>
        </div>
        <div class="detail-fact" data-animate>
          <h2 class="meta-label">{t('project.stack.title')}</h2>
          <ul>{project.stack.map(item => <li>{item}</li>)}</ul>
        </div>
        {project.links?.length ? (
          <div class="detail-fact" data-animate>
            <h2 class="meta-label">{t('project.links.title')}</h2>
            <ul>{project.links.map(link => <li><a class="text-link" href={link.href} target="_blank" rel="noopener noreferrer">{link.label} ↗</a></li>)}</ul>
          </div>
        ) : null}
      </aside>
    </div>
    {nextProject && (
      <nav class="next-project" aria-label={pt ? 'próximo projeto' : 'next project'}>
        <span class="meta-label">{pt ? 'próximo projeto' : 'next project'} / {String((currentIndex + 1) % entries.length + 1).padStart(2, '0')}</span>
        <a href={projectHref(nextProject.slug)}>{nextProject.title} <span aria-hidden="true">↗</span></a>
      </nav>
    )}
  </main>
  <Contact lang={lang} />
</Layout>
<style>
  .project-detail { padding-top: clamp(3rem, 7vw, 7rem); }
  .detail-meta { display: flex; justify-content: space-between; gap: 2rem; border-bottom: 1px solid var(--border); padding-bottom: 1rem; }
  .back-link { font-size: .83rem; text-decoration: none; }
  .back-link:hover { color: var(--accent); }
  .detail-intro { padding-block: clamp(3rem, 6vw, 6rem); }
  .detail-intro h1 { font: 400 clamp(2.8rem, 5vw, 5rem)/1.1 var(--font-display); letter-spacing: -.058em; margin-top: 1rem; }
  .detail-intro p { margin-top: 1rem; font-size: clamp(1.1rem, 1.7vw, 1.5rem); color: var(--muted); max-width: 50ch; }
  .detail-image { border-top: 1px solid var(--border); padding-top: 1.25rem; }
  .detail-image img { background: var(--surface); width: 100%; max-height: 680px; object-fit: contain; }
  .detail-image figcaption { margin-top: .8rem; text-align: right; }
  .detail-grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(13rem, .7fr); gap: clamp(3rem, 12vw, 12rem); padding-block: clamp(4rem, 8vw, 8rem); }
  .detail-story { display: grid; gap: 3.5rem; }
  .detail-story h2, .detail-aside h2 { margin-bottom: 1rem; }
  .detail-story p { font-size: 1.05rem; line-height: 1.75; color: var(--muted); max-width: 57ch; }
  .detail-story .detail-lead { font-size: clamp(1.25rem, 2vw, 1.65rem); line-height: 1.45; color: var(--text); letter-spacing: -.025em; }
  .detail-aside { display: grid; align-content: start; gap: 2.3rem; }
  .detail-fact { border-top: 1px solid var(--border); padding-top: 1rem; }
  .detail-fact ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .4rem .85rem; }
  .detail-fact li { font-size: .82rem; line-height: 1.6; color: var(--muted); }
  .detail-fact a { color: var(--text); }
  .next-project { border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: 1.7rem 0 clamp(2rem, 5vw, 5rem); }
  .next-project a { font: 500 clamp(1.25rem, 2.5vw, 2rem)/1.15 var(--font-display); letter-spacing: -.035em; text-decoration: none; }
  .next-project a:hover { color: var(--accent); }
  [data-project-type="coisas-bonitas"] .detail-image img { object-position: left center; }
  @media(max-width:750px){.detail-grid{grid-template-columns:1fr;gap:3rem}.next-project{display:grid}}
</style>