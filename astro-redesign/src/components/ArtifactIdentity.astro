---
/** A shared scaffold with project-specific visual grammars, not four copies of one decoration. */
interface Props { kind: string; lang: string }
const { kind, lang } = Astro.props;
const pt = lang === 'pt';
const identity: Record<string, { glyph: string; labelPt: string; labelEn: string; detail: string }> = {
  riji: { glyph: '日', labelPt: 'escrita em primeiro plano', labelEn: 'writing comes first', detail: '001 / 003 / 007' },
  'coisas-bonitas': { glyph: '◉', labelPt: 'transmissão e arquivo', labelEn: 'broadcast and archive', detail: 'hkcr / radio' },
  'ambi-mixer': { glyph: '≈', labelPt: 'camadas de som', labelEn: 'layers of sound', detail: 'a + b + c' },
  'dither-studio': { glyph: '░', labelPt: 'imagem em pontos', labelEn: 'image into dots', detail: '8 × 8 / 1bit' }
};
const motif = identity[kind] ?? identity.riji;
---
<div class="artifact-identity" data-identity={kind} aria-hidden="true">
  <span class="identity-label">{pt ? motif.labelPt : motif.labelEn}</span>
  <span class="identity-sign">{motif.glyph}</span>
  <span class="identity-detail">{motif.detail}</span>
  {kind === 'riji' && <div class="writing-lines"><i></i><i></i><i></i><i></i><i></i></div>}
  {kind === 'coisas-bonitas' && <div class="radio-rings"><i></i><i></i><i></i></div>}
  {kind === 'ambi-mixer' && <div class="sound-bars">{Array.from({length: 21}, (_, i) => <i style={`--index:${i}`}></i>)}</div>}
  {kind === 'dither-studio' && <div class="dither-field"></div>}
</div>
<style>
  .artifact-identity{--id-ink:#332e2c;position:relative;min-height:clamp(9rem,19vw,18rem);overflow:hidden;border:1px solid color-mix(in srgb,var(--id-ink) 20%,transparent);color:var(--id-ink);isolation:isolate}
  .artifact-identity[data-identity="riji"]{background:#d9d8e2}
  .artifact-identity[data-identity="coisas-bonitas"]{background:#c2dcc9}
  .artifact-identity[data-identity="ambi-mixer"]{background:#ebd4b5}
  .artifact-identity[data-identity="dither-studio"]{background:#d9cade}
  .identity-label,.identity-detail{position:absolute;z-index:3;font:.68rem/1.3 var(--font-mono)}
  .identity-label{left:1rem;top:1rem}.identity-detail{right:1rem;bottom:1rem}
  .identity-sign{position:absolute;z-index:2;left:50%;top:50%;transform:translate(-50%,-50%);font:400 clamp(5rem,11vw,11rem)/1 var(--font-mono);letter-spacing:-.08em}
  .writing-lines{position:absolute;inset:20% 12% 15%;display:grid;align-content:space-evenly}
  .writing-lines i{height:1px;background:#554f6160}
  .writing-lines i:nth-child(even){width:82%}
  .radio-rings{position:absolute;inset:0;display:grid;place-items:center}
  .radio-rings i{position:absolute;border:1px solid #315b4880;border-radius:50%;width:35%;aspect-ratio:1}
  .radio-rings i:nth-child(2){width:63%}.radio-rings i:nth-child(3){width:96%}
  .sound-bars{position:absolute;inset:23% 8%;display:flex;align-items:center;justify-content:space-between;gap:.3rem}
  .sound-bars i{width:2px;background:#865d4e99;height:calc(12% + (var(--index) * 3%));max-height:94%}
  .sound-bars i:nth-child(3n){height:65%}.sound-bars i:nth-child(5n){height:24%}
  .dither-field{position:absolute;inset:7%;opacity:.4;background-image:radial-gradient(#514063 1px,transparent 1px);background-size:9px 9px}
  @media(prefers-reduced-motion:no-preference){
    .artifact-identity[data-identity="coisas-bonitas"]:hover .radio-rings{transform:scale(1.045)}
    .artifact-identity[data-identity="ambi-mixer"]:hover .sound-bars{transform:scaleY(.9)}
    .radio-rings,.sound-bars{transition:transform 650ms var(--ease-out)}
  }
</style>