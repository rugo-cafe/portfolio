---
import { Icon } from 'astro-icon/components';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang as any);

// DADOS REAIS EXTRAÍDOS DO LINKEDIN
const experiences = [
  {
    period: t('exp.camerge2.period'), // Jun 2026 - o momento
    role: t('exp.camerge2.role'),
    company: t('exp.camerge2.company'),
    desc: t('exp.camerge2.desc'),
    techs: ['HubSpot', 'CRM', 'Meta Ads', 'Google Ads']
  },
  {
    period: t('exp.camerge.period'), // Jun 2024 - Jun 2026
    role: t('exp.camerge.role'),
    company: t('exp.camerge.company'),
    desc: t('exp.camerge.desc'),
    techs: ['Figma', 'HubSpot', 'HTML/CSS', 'WordPress']
  },
  {
    period: t('exp.bioma.period'), // Mai 2023 - Mai 2024
    role: t('exp.bioma.role'),
    company: t('exp.bioma.company'),
    desc: t('exp.bioma.desc'),
    // Techs: WordPress, Figma, IoT, SolidWorks
    techs: ['WordPress', 'Figma', 'IoT', 'Prototyping']
  }
];

const education = [
  {
    period: t('edu.ufsc.period'),
    degree: t('edu.ufsc.degree'),
    school: t('edu.ufsc.school'),
    desc: t('edu.ufsc.desc')
  },
  {
    period: t('edu.ifc.period'),
    degree: t('edu.ifc.degree'),
    school: t('edu.ifc.school'),
    desc: t('edu.ifc.desc')
  }
];
---

<section id="experience" class="w-full max-w-[1400px] mx-auto px-6 md:px-12 py-16 md:py-24 relative">
  
  <!-- Título XP -->
  <div class="mb-10 md:mb-16 flex flex-col md:flex-row md:items-end justify-between gap-4">
    <h2 class="font-display font-bold text-4xl md:text-5xl text-brand-dark dark:text-brand-light tracking-tight">
      {t('exp.title')}<span class="text-brand-purple">.</span>
    </h2>
    <div class="h-px bg-brand-dark/10 dark:bg-brand-light/10 flex-1 ml-6 mb-2 hidden md:block"></div>
    <span class="text-xs font-mono uppercase tracking-widest text-brand-dark/50 dark:text-brand-light/50 mb-1.5 hidden md:block">
      {t('exp.path')}
    </span>
  </div>

  <!-- Lista XP -->
  <div class="flex flex-col relative border-l border-brand-dark/10 dark:border-brand-light/10 ml-3 md:ml-0 md:border-l-0 mb-16 md:mb-24">
    {experiences.map((job, index) => (
      <div 
        class="
          group relative py-6 md:py-10 pl-8 md:pl-6 pr-6 md:pr-8 
          md:border-t border-brand-dark/5 dark:border-brand-light/5 
          rounded-xl md:rounded-2xl
          transition-all duration-500 ease-out
          hover:bg-brand-purple/[0.02] dark:hover:bg-brand-purple/[0.03]
          hover:border-brand-purple/20 dark:hover:border-brand-purple/10
          hover:shadow-lg hover:shadow-brand-purple/5
          hover:scale-[1.005]
        "
        style={`--stagger: ${index * 50}ms`}
      >
        
        <!-- Dot Mobile com pulse no hover -->
        <div class="absolute left-[-5px] top-0 md:hidden mt-1.5">
          <span class="relative flex h-2.5 w-2.5">
            <span class="absolute inline-flex h-full w-full rounded-full bg-brand-purple opacity-0 group-hover:opacity-75 group-hover:animate-ping transition-opacity"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-brand-purple ring-4 ring-white dark:ring-[#1a1a1a] transition-all group-hover:ring-brand-purple/20"></span>
          </span>
        </div>

        <!-- Glow effect on hover -->
        <div class="absolute inset-0 rounded-2xl bg-gradient-to-r from-brand-purple/6 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 items-start relative z-10">
            <div class="md:col-span-3">
              <span class="inline-flex min-w-[7.5rem] justify-center py-1 px-2.5 rounded-full glass-subtle text-xs font-mono font-semibold text-brand-dark/75 dark:text-brand-light/85 group-hover:border-brand-purple/30 group-hover:text-brand-purple dark:group-hover:text-brand-light transition-all duration-300">
                {job.period}
              </span>
            </div>
            <div class="md:col-span-5 mb-2 md:mb-0">
              <h3 class="font-display text-xl md:text-2xl font-bold text-brand-dark dark:text-brand-light mb-1 flex items-center gap-2 group-hover:text-brand-purple dark:group-hover:text-brand-purple transition-colors duration-300">
                {job.role}
              </h3>
              <span class="text-sm md:text-base font-medium text-brand-dark/60 dark:text-brand-light/60 flex items-center gap-2">
                {job.company}
              </span>
            </div>
            <div class="md:col-span-4">
              <p class="text-sm md:text-[15px] leading-relaxed text-brand-dark/70 dark:text-brand-light/70 pr-1">
                {job.desc}
              </p>
              <div class="flex flex-wrap gap-2 mt-3">
                 {job.techs.map((tech, techIndex) => (
                   <span 
                     class="text-[10px] uppercase tracking-wider font-mono opacity-40 group-hover:opacity-100 transition-all duration-300 group-hover:text-brand-purple"
                     style={`transition-delay: ${techIndex * 50}ms`}
                   >
                     {tech}
                   </span>
                 ))}
              </div>
            </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Título Educação -->
  <div class="mb-6 md:mb-12 flex items-center gap-4 opacity-80">
    <div class="w-8 h-8 rounded-full bg-brand-purple/10 flex items-center justify-center text-brand-purple">
      <Icon name="ph:student-bold" class="w-4 h-4" />
    </div>
    <h3 class="font-display font-bold text-2xl md:text-3xl text-brand-dark dark:text-brand-light tracking-tight">
      {t('edu.title')}
    </h3>
    <div class="h-px bg-brand-dark/10 dark:bg-brand-light/10 flex-1"></div>
  </div>

  <!-- Lista Educação -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
    {education.map((edu) => (
      <div class="relative p-5 sm:p-6 rounded-2xl surface-muted hover:border-brand-purple/30 dark:hover:border-brand-purple/20 transition-colors">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between mb-4">
           <div>
             <h4 class="font-bold text-base sm:text-lg text-brand-dark dark:text-brand-light leading-tight mb-1">
               {edu.degree}
             </h4>
             <p class="text-sm text-brand-dark/60 dark:text-brand-light/60 font-medium">
               {edu.school}
             </p>
           </div>
           <span class="inline-flex self-start sm:self-auto whitespace-nowrap text-[11px] sm:text-xs font-mono font-semibold py-1 px-2 rounded-md glass-subtle text-brand-dark/75 dark:text-brand-light/85">
             {edu.period}
           </span>
        </div>
        <p class="text-sm text-brand-dark/70 dark:text-brand-light/70 leading-relaxed">
          {edu.desc}
        </p>
      </div>
    ))}
  </div>

</section>
