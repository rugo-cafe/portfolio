---
import { useTranslations } from '../i18n/utils';
interface Props { lang: string }
const { lang } = Astro.props;
const t = useTranslations(lang as any);
const pt = lang === 'pt';
const experiences = [
  { period: t('exp.camerge2.period'), role: t('exp.camerge2.role'), company: t('exp.camerge2.company'), desc: t('exp.camerge2.desc') },
  { period: t('exp.camerge.period'), role: t('exp.camerge.role'), company: t('exp.camerge.company'), desc: t('exp.camerge.desc') },
  { period: t('exp.bioma.period'), role: t('exp.bioma.role'), company: t('exp.bioma.company'), desc: t('exp.bioma.desc') },
];
const education = [
  { period: t('edu.ufsc.period'), degree: t('edu.ufsc.degree'), school: t('edu.ufsc.school') },
  { period: t('edu.ifc.period'), degree: t('edu.ifc.degree'), school: t('edu.ifc.school') },
];
---
<section id="experience" class="container experience" aria-labelledby="experience-heading">
  <div class="experience-header">
    <h2 id="experience-heading">{pt ? 'por onde passei' : 'where i’ve worked'}</h2>
    <span class="meta-label">{pt ? 'algumas coisas que fiz fora dos projetos pessoais' : 'some things beyond my personal projects'}</span>
  </div>
  <ol class="job-list">
    {experiences.map(job => (
      <li class="job">
        <span class="job-time">{job.period}</span>
        <div class="job-title"><h3>{job.role}</h3><span>{job.company}</span></div>
        <p>{job.desc}</p>
      </li>
    ))}
  </ol>
  <div class="studies">
    <span class="meta-label">{pt ? 'e estudei por aqui' : 'and i studied here'}</span>
    {education.map(item => (
      <p><strong>{item.degree}</strong> <span>{item.school} · {item.period}</span></p>
    ))}
  </div>
</section>
<style>
  .experience { padding-block: clamp(4rem, 7vw, 7rem); }
  .experience-header { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; border-top: 1px solid var(--border); padding-top: 1rem; }
  h2 { font: 400 clamp(1.5rem, 2.35vw, 2.25rem)/1.15 var(--font-display); letter-spacing: -.045em; }
  .experience-header .meta-label { text-align: right; max-width: 24ch; }
  .job-list { list-style: none; padding: 1.5rem 0 0; margin: 0; }
  .job { display: grid; grid-template-columns: minmax(6rem,.6fr) minmax(11rem,1.2fr) minmax(0,1.5fr); gap: clamp(1rem, 4vw, 4rem); align-items: baseline; border-bottom: 1px solid var(--border); padding: 1.4rem 0; }
  .job-time { color: var(--muted); font: .72rem/1.55 var(--font-mono); }
  h3 { font: 500 1.05rem/1.35 var(--font-display); letter-spacing: -.015em; }
  .job-title span { font-size: .8rem; color: var(--muted); display: block; margin-top: .3rem; }
  .job p { font-size: .85rem; line-height: 1.6; color: var(--muted); max-width: 55ch; }
  .studies { display: grid; grid-template-columns: 1fr 1.5fr 1.5fr; gap: 1.5rem; align-items: start; padding-block: 2rem; }
  .studies p { font-size: .83rem; line-height: 1.6; }
  .studies strong { font-weight: 600; }
  .studies span { display: block; color: var(--muted); }
  @media(max-width:820px){.job{grid-template-columns:1fr 2fr;gap:.65rem 1.5rem}.job p{grid-column:2}.studies{grid-template-columns:1fr 1fr}.studies>.meta-label{grid-column:1/-1}}
  @media(max-width:540px){.experience-header{align-items:start;flex-direction:column}.experience-header .meta-label{text-align:left}.job{grid-template-columns:1fr;gap:.45rem}.job p{grid-column:1;margin-top:.3rem}.studies{grid-template-columns:1fr}}
</style>