---
import { useTranslations } from '../i18n/utils';
import SectionHeading from './SectionHeading.astro';
interface Props { lang: string }
const { lang } = Astro.props;
const t = useTranslations(lang as any);
const experiences = [
  { period: t('exp.camerge2.period'), role: t('exp.camerge2.role'), company: t('exp.camerge2.company'), desc: t('exp.camerge2.desc') },
  { period: t('exp.camerge.period'), role: t('exp.camerge.role'), company: t('exp.camerge.company'), desc: t('exp.camerge.desc') },
  { period: t('exp.bioma.period'), role: t('exp.bioma.role'), company: t('exp.bioma.company'), desc: t('exp.bioma.desc') },
];
const education = [
  { period: t('edu.ufsc.period'), degree: t('edu.ufsc.degree'), school: t('edu.ufsc.school'), desc: t('edu.ufsc.desc') },
  { period: t('edu.ifc.period'), degree: t('edu.ifc.degree'), school: t('edu.ifc.school'), desc: t('edu.ifc.desc') },
];
---
<section id="experience" class="container section-space" aria-labelledby="experience-heading">
  <SectionHeading id="experience-heading" index="03 /" title={t('exp.title')} aside={t('exp.path')} />
  <ol class="record-list">
    {experiences.map((job, i) => (
      <li class="record" data-animate>
        <span class="meta-label">{String(i + 1).padStart(2, '0')}</span>
        <div class="record-identity"><h3>{job.role}</h3><span>{job.company}</span></div>
        <p>{job.desc}</p>
        <span class="meta-label record-period">{job.period}</span>
      </li>
    ))}
  </ol>
  <div class="education" aria-labelledby="education-heading">
    <h3 id="education-heading">{t('edu.title')}</h3>
    <div>
      {education.map(item => (
        <div class="education-row" data-animate>
          <div><h4>{item.degree}</h4><span class="meta-label">{item.school}</span></div>
          <p>{item.desc}</p>
          <span class="meta-label">{item.period}</span>
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .record-list { list-style: none; padding: clamp(2rem, 4vw, 4rem) 0 0; margin: 0; }
  .record { display: grid; grid-template-columns: 2rem minmax(10rem, 1fr) minmax(12rem, 1.15fr) minmax(7rem, .7fr); gap: clamp(.8rem, 2vw, 2rem); padding: 1.6rem 0; border-bottom: 1px solid var(--border); align-items: start; }
  .record-identity h3 { font: 500 clamp(1.1rem, 1.7vw, 1.5rem)/1.25 var(--font-display); letter-spacing: -.025em; }
  .record-identity span { display: block; margin-top: .4rem; color: var(--muted); font-size: .9rem; }
  .record p { font-size: .9rem; line-height: 1.65; color: var(--muted); max-width: 50ch; }
  .record-period { text-align: right; }
  .education { display: grid; grid-template-columns: minmax(12rem, 1fr) minmax(0, 3fr); gap: 3rem; padding-top: clamp(3rem, 6vw, 6rem); }
  .education>h3 { font: 500 1.25rem/1.25 var(--font-display); letter-spacing: -.02em; }
  .education-row { border-top: 1px solid var(--border); padding: 1.25rem 0; display: grid; grid-template-columns: 1fr 1.25fr auto; gap: 1.25rem; }
  .education-row h4 { font-weight: 500; font-size: .97rem; margin-bottom: .35rem; }
  .education-row p { color: var(--muted); font-size: .85rem; line-height: 1.6; }
  @media (max-width: 950px) { .record { grid-template-columns: 1.5rem 1fr 1.3fr; } .record-period { grid-column: 2 / -1; text-align: left; } .education { grid-template-columns: 1fr; gap: 1.5rem; } }
  @media (max-width: 630px) { .record { grid-template-columns: 1.5rem 1fr; gap: .6rem 1rem; } .record p, .record-period { grid-column: 2; } .record p { margin-top: .4rem; } .education-row { grid-template-columns: 1fr; gap: .55rem; } }
</style>