---
interface Props { currentLang: string }
const { currentLang } = Astro.props;
const pt = currentLang === 'pt';
const home = pt ? '/' : '/en';
const path = Astro.url.pathname;
const slugMatch = path.match(/\/projects\/([^/]+)\/?$/);
const otherLangHref = slugMatch
  ? (pt ? '/en/projects/' : '/projects/') + slugMatch[1]
  : (pt ? '/en' : '/');
---
<header class="site-header" id="main-header">
  <div class="container header-inner">
    <a class="site-brand" href={home} aria-label="vitor hugo cunha — home">
      <span class="brand-full">vitor hugo cunha</span><span class="brand-short" aria-hidden="true">vhc.</span>
    </a>
    <nav class="site-links" aria-label={pt ? 'navegação principal' : 'main navigation'}>
      <a href={home + '#projects'}>{pt ? 'trabalhos' : 'work'}</a>
      <a href={home + '#about'}>{pt ? 'sobre' : 'about'}</a>
      <a href={home + '#contact'}>{pt ? 'contato' : 'contact'}</a>
    </nav>
    <div class="site-controls">
      <a class="language-switch" href={otherLangHref} aria-label={pt ? 'switch to english' : 'mudar para português'}>{pt ? 'en' : 'pt'}</a>
      <button type="button" id="theme-toggle" class="theme-switch" aria-label={pt ? 'alternar tema' : 'toggle theme'} aria-pressed="false"><span class="theme-symbol" aria-hidden="true">◐</span></button>
    </div>
  </div>
</header>
<script>
  const initThemeButton = () => {
    const button = document.getElementById('theme-toggle');
    if (!button || button.dataset.bound === 'true') return;
    button.dataset.bound = 'true';
    const sync = () => button.setAttribute('aria-pressed', String(document.documentElement.classList.contains('dark')));
    sync();
    button.addEventListener('click', () => { window.toggleTheme?.(); sync(); });
  };
  document.addEventListener('astro:page-load', initThemeButton);
  initThemeButton();
</script>
<style>
  .site-header { z-index: 40; position: sticky; top: 0; background: var(--bg); border-bottom: 1px solid var(--border); transition: background-color var(--speed-medium) var(--ease-standard); }
  .header-inner { min-height: 4.75rem; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1.5rem; }
  .site-brand { font: 550 .98rem/1.2 var(--font-display); letter-spacing: -.035em; text-decoration: none; white-space: nowrap; }
  .brand-short { display: none; }
  .site-links, .site-controls { display: flex; align-items: center; }
  .site-links { gap: clamp(1.25rem, 3vw, 3.5rem); }
  .site-links a, .language-switch { font-size: .81rem; text-decoration: none; color: var(--muted); transition: color var(--speed-fast) ease; }
  .site-links a:hover, .site-brand:hover, .language-switch:hover { color: var(--accent); }
  .site-controls { justify-self: end; gap: 1.1rem; }
  .theme-switch { height: 2.5rem; width: 2.5rem; border: 1px solid var(--border); border-radius: 50%; background: transparent; color: var(--text); transition: transform var(--speed-medium) var(--ease-out), border-color var(--speed-fast) ease; }
  .theme-switch:hover { transform: rotate(35deg); border-color: var(--accent); }
  .theme-symbol { display: block; font-size: 1.15rem; line-height: 1; }
  @media(max-width:720px){.header-inner{grid-template-columns:1fr auto auto;gap:.8rem;min-height:4.1rem}.site-links{gap:1.1rem}.site-links a:nth-child(2){display:none}.site-controls{gap:.7rem}}
  @media(max-width:490px){.brand-full{display:none}.brand-short{display:inline}.site-links a:last-child{display:none}.site-controls{gap:.6rem}}
</style>