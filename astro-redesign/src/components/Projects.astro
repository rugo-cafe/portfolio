    transition:
      opacity 240ms ease,
      transform 320ms cubic-bezier(0.19, 1, 0.22, 1);
    will-change: opacity, transform;
  }

  #project-modal[data-state="open"] {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }

  #project-modal[data-state="closing"] {
    opacity: 0;
    transform: translate3d(0, 10px, 0) scale(0.985);
  }

  #project-modal-backdrop {
    opacity: 0;
    transition:
      opacity 260ms ease,
      backdrop-filter 260ms ease;
    will-change: opacity;
  }

  #project-modal-backdrop[data-state="open"] {
    opacity: 1;
    pointer-events: auto;
  }

  #project-modal-backdrop[data-state="closing"] {
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    #project-modal,
    #project-modal-backdrop {
      transition-duration: 1ms;
    }
  }

