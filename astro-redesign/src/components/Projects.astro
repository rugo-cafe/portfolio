---
import { Icon } from 'astro-icon/components';
import { useTranslations } from '../i18n/utils';
import { getProjectEntries, ProjectStatus } from '../data/projects';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang as any);

const projects = getProjectEntries(lang as any);
const projectHref = (slug: string) => (lang === 'pt' ? `/projects/${slug}` : `/${lang}/projects/${slug}`);

const statusConfig: Record<ProjectStatus, { label: string; class: string }> = {
  'live': { label: t('projects.status.live'), class: 'bg-green-500/20 text-green-600 dark:text-green-400' },
  'in-progress': { label: t('projects.status.progress'), class: 'bg-yellow-500/20 text-yellow-600 dark:text-yellow-400' },
  'planned': { label: t('projects.status.planned'), class: 'bg-brand-purple/20 text-brand-purple' },
};

const colorConfig: Record<string, string> = {
  purple: 'from-brand-purple/12 to-transparent',
  terracotta: 'from-brand-terracotta/12 to-transparent',
  green: 'from-brand-green/12 to-transparent',
};

const CARD_TAG_LIMIT = 3;
const MOBILE_TAG_LIMIT = 2;

---

<section id="projects" class="w-full max-w-[1400px] mx-auto px-6 md:px-12 py-16 md:py-32 relative">
  
  <!-- Section Header -->
  <div class="mb-10 md:mb-20 flex flex-col md:flex-row md:items-end justify-between gap-4 reveal">
    <h2 class="font-display font-bold text-4xl md:text-5xl text-brand-dark dark:text-brand-light tracking-tight lowercase" data-section-title>
      {t('nav.projects')}<span class="text-brand-purple">.</span>
    </h2>
    <div class="h-px bg-brand-dark/10 dark:bg-brand-light/10 flex-1 ml-6 mb-2 hidden md:block"></div>
    <span class="text-xs font-mono uppercase tracking-widest text-brand-dark/50 dark:text-brand-light/50 mb-1.5 hidden md:block">
      {t('projects.sectionLabel')}
    </span>
  </div>

  <div class="md:hidden -mx-6 pl-6 pr-6 overflow-x-auto [scrollbar-width:none] [-ms-overflow-style:none] mobile-projects-strip">
    <div class="flex gap-4 snap-x snap-mandatory pb-2">
      {projects.map((project) => (
        <a
          href={projectHref(project.slug)}
          data-astro-prefetch="viewport"
          aria-label={`${t('projects.details')}: ${project.title}`}
          class="project-card group snap-start shrink-0 w-[82vw] max-w-[340px] rounded-[2rem] surface overflow-hidden text-left"
        >
          <div class={`h-44 relative overflow-hidden bg-gradient-to-br ${colorConfig[project.color]}`}>
            {project.resolvedImage ? (
              <img
                src={project.resolvedImage}
                alt={project.imageAlt}
                class={`project-card-image w-full h-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] ${project.slug === 'riji' ? '' : 'object-left'}`}
                loading="lazy"
              />
            ) : null}
            <div class="absolute inset-0 bg-linear-to-t from-black/18 via-transparent to-transparent"></div>
          </div>

          <div class="p-5 space-y-4">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <h3 class="font-display font-bold text-2xl tracking-tight text-brand-dark dark:text-brand-light lowercase">
                  {project.title}
                </h3>
                <p class="text-sm text-brand-dark/52 dark:text-brand-light/52 lowercase truncate">
                  {project.subtitle}
                </p>
              </div>
              <span class={`shrink-0 px-2.5 py-1 rounded-full text-[9px] font-bold uppercase tracking-[0.18em] leading-none whitespace-nowrap ${statusConfig[project.status].class}`}>
                {statusConfig[project.status].label}
              </span>
            </div>

            <p class="text-sm leading-relaxed text-brand-dark/72 dark:text-brand-light/72 line-clamp-2">
              {project.overview}
            </p>

            <div class="flex flex-wrap items-center gap-2 min-w-0">
              {project.stack.slice(0, MOBILE_TAG_LIMIT).map((tag) => (
              <span class="inline-flex shrink-0 text-[11px] uppercase tracking-wider font-mono leading-none text-brand-dark/45 dark:text-brand-light/40 bg-black/[0.045] dark:bg-white/5 px-2.5 py-1 rounded-lg">
                  {tag}
                </span>
              ))}
              {project.stack.length > MOBILE_TAG_LIMIT && (
                <span class="shrink-0 text-[11px] uppercase tracking-wider font-mono text-brand-purple bg-brand-purple/10 px-2.5 py-1 rounded-lg">
                  +{project.stack.length - MOBILE_TAG_LIMIT}
                </span>
              )}
            </div>

            <div class="inline-flex items-center gap-2 text-sm font-medium text-brand-purple">
              <span>{t('projects.details')}</span>
              <Icon name="ph:arrow-right-bold" class="w-4 h-4" />
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>

  <!-- Projects Grid -->
  <div class="hidden md:grid grid-cols-1 md:grid-cols-2 gap-6">
    {projects.map((project, index) => (
      <a 
        href={projectHref(project.slug)}
        data-astro-prefetch="viewport"
        aria-label={`${t('projects.details')}: ${project.title}`}
        class={`project-card group relative p-0 rounded-3xl surface text-left overflow-hidden reveal reveal-delay-${(index + 1) * 100} cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple/50 md:min-h-[240px] motion-reduce:transform-none motion-reduce:transition-none`}
      >
        <!-- Gradient Background on Hover -->
        <div class={`absolute inset-0 bg-gradient-to-br ${colorConfig[project.color]} opacity-0 group-hover:opacity-70 transition-opacity duration-700 pointer-events-none`}></div>
        
        <!-- Content -->
        <div class="relative z-10 flex flex-col md:grid md:grid-cols-[minmax(190px,32%)_minmax(0,1fr)] h-full">
          <div class="w-full shrink-0 overflow-hidden bg-black/[0.04] dark:bg-white/5 md:h-full border-b md:border-b-0 md:border-r border-black/8 dark:border-brand-light/10">
            <div class="w-full h-full">
              {project.resolvedImage ? (
                <img
                  src={project.resolvedImage}
                  alt={project.imageAlt}
                  class={`project-card-image w-full h-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] ${project.slug === 'riji' ? '' : 'object-left'}`}
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-xs uppercase tracking-wider text-brand-dark/40 dark:text-brand-light/40 font-mono">
                  {t('projects.modal.preview')}
                </div>
              )}
            </div>
          </div>

          <div class="min-w-0 grid grid-rows-[auto_auto_1fr_auto] p-5 md:px-5 md:py-4">
            <div class="flex items-start justify-between gap-4 mb-3">
              <div class="min-w-0">
                <h3 class="font-display font-bold text-xl md:text-2xl text-brand-dark dark:text-brand-light group-hover:text-brand-purple transition-colors duration-300 lowercase">
                  {project.title}
                </h3>
                <span class="text-sm text-brand-dark/50 dark:text-brand-light/50 lowercase">
                  {project.subtitle}
                </span>
              </div>
              <span class={`shrink-0 px-2.5 py-1 rounded-full text-[9px] md:text-[10px] font-bold uppercase tracking-[0.18em] leading-none whitespace-nowrap ${statusConfig[project.status].class}`}>
                {statusConfig[project.status].label}
              </span>
            </div>

            <p class="text-base text-brand-dark/70 dark:text-brand-light/70 leading-relaxed mb-4 max-w-[40ch]">
              {project.overview}
            </p>

            <div class="flex flex-wrap items-center gap-2 min-w-0">
              {project.stack.slice(0, CARD_TAG_LIMIT).map((tag) => (
                <span class="inline-flex shrink-0 text-[11px] uppercase tracking-wider font-mono leading-none text-brand-dark/45 dark:text-brand-light/40 bg-black/[0.045] dark:bg-white/5 px-2.5 py-1 rounded-lg">
                  {tag}
                </span>
              ))}
              {project.stack.length > CARD_TAG_LIMIT && (
                <span class="shrink-0 text-[11px] uppercase tracking-wider font-mono text-brand-purple bg-brand-purple/10 px-2.5 py-1 rounded-lg">
                  +{project.stack.length - CARD_TAG_LIMIT}
                </span>
              )}
            </div>

            <div class="pt-4 flex items-center gap-2 text-sm font-medium text-brand-purple opacity-70 md:opacity-0 translate-y-1 transition-all duration-300 lowercase group-hover:opacity-100 group-hover:translate-y-0">
              <span>{t('projects.details')}</span>
              <Icon name="ph:arrow-right-bold" class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" />
            </div>
          </div>
        </div>
        
        <!-- Corner Decoration -->
        <div class="absolute -bottom-8 -right-8 w-32 h-32 bg-brand-purple/5 rounded-full blur-2xl opacity-0 group-hover:opacity-40 transition-opacity duration-700"></div>
      </a>
    ))}
  </div>

  <!-- GitHub Link -->
  <div class="text-center mt-12 reveal">
    <a 
      href="https://github.com/rugo-cafe" 
      target="_blank"
      class="inline-flex items-center gap-2 text-sm text-brand-dark/50 dark:text-brand-light/50 hover:text-brand-purple transition-colors duration-300 lowercase"
    >
      <Icon name="simple-icons:github" class="w-4 h-4" />
      <span>{t('projects.github.more')}</span>
      <Icon name="ph:arrow-up-right-bold" class="w-3 h-3" />
    </a>
  </div>

</section>

<style is:global>
  .mobile-projects-strip::-webkit-scrollbar {
    display: none;
  }

  @media (min-width: 768px) and (hover: hover) and (pointer: fine) {
    .project-card {
      transform-origin: center;
      will-change: transform;
      transition:
        transform 520ms cubic-bezier(0.16, 1, 0.3, 1),
        box-shadow 520ms cubic-bezier(0.16, 1, 0.3, 1),
        border-color 360ms ease;
    }

    .project-card:hover {
      transform: translateY(-10px) scale(1.06);
      border-color: rgba(176, 102, 255, 0.35);
      box-shadow:
        0 42px 90px -56px rgba(176, 102, 255, 0.65),
        0 20px 50px -30px rgba(0, 0, 0, 0.45);
      z-index: 10;
    }

    .project-card:hover .project-card-image {
      transform: scale(1.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-card-image {
      transition-duration: 1ms !important;
      transform: none !important;
    }
  }
</style>
