---
import { getProjectEntries } from '../data/projects';
import { useTranslations } from '../i18n/utils';
import SectionHeading from './SectionHeading.astro';
import ProjectRow from './ProjectRow.astro';
import ProjectStage from './ProjectStage.astro';
interface Props { lang: string }
const { lang } = Astro.props;
const t = useTranslations(lang as any);
const projects = getProjectEntries(lang as any);
---
<section id="projects" class="container section-space" aria-labelledby="projects-heading" data-project-index>
  <SectionHeading
    id="projects-heading"
    index="01 /"
    title={lang === 'pt' ? 'trabalhos selecionados' : 'selected work'}
    aside={lang === 'pt' ? 'interfaces, ferramentas e experiências para a web' : 'interfaces, tools and experiences for the web'}
  />
  <div class="project-layout">
    <ol class="project-list">
      {projects.map((project, index) => <ProjectRow project={project} index={index} lang={lang} />)}
    </ol>
    <ProjectStage projects={projects} />
  </div>
  <div class="project-bottom">
    <span class="meta-label">{String(projects.length).padStart(2, '0')} / {lang === 'pt' ? 'projetos' : 'projects'}</span>
    <a class="text-link" href="https://github.com/rugo-cafe" target="_blank" rel="noopener noreferrer">{t('projects.github.more')} ↗</a>
  </div>
</section>
<script>import '../scripts/project-previews';</script>
<style>
  .project-layout { display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(0, .88fr); gap: clamp(2rem, 5vw, 6rem); padding-top: 2rem; align-items: start; }
  .project-list { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--border); }
  .project-bottom { display: flex; justify-content: space-between; align-items: baseline; gap: 2rem; margin-top: 2rem; font-size: .85rem; }
  @media(max-width:850px){.project-layout{display:block}.project-bottom{margin-top:1.4rem}}
</style>