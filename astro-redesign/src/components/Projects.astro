---
import { existsSync } from 'node:fs';
import { Icon } from 'astro-icon/components';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang as any);

// Project data
type ProjectStatus = 'live' | 'in-progress' | 'planned';

interface Project {
  id: string;
  title: string;
  tagline: string;
  desc: string;
  tags: string[];
  status: ProjectStatus;
  color: string;
  image: string;
  fallbackImage: string;
  imageAlt: string;
}

const projects: Project[] = [
  {
    id: 'riji',
    title: '日记 Riji',
    tagline: t('projects.riji.tagline'),
    desc: t('projects.riji.desc'),
    tags: ['Vite', 'TypeScript', 'Tailwind', 'Supabase', 'localStorage'],
    status: 'in-progress',
    color: 'purple',
    image: '/projects/riji-thumb.webp',
    fallbackImage: '/projects/riji-placeholder.svg',
    imageAlt: 'captura da interface do riji',
  },
  {
    id: 'coisas-bonitas',
    title: 'Coisas Bonitas',
    tagline: t('projects.coisas.tagline'),
    desc: t('projects.coisas.desc'),
    tags: ['HTML', 'CSS', 'JavaScript', 'Neocities'],
    status: 'live',
    color: 'terracotta',
    image: '/projects/coisas-bonitas-thumb.webp',
    fallbackImage: '/projects/coisas-bonitas-placeholder.svg',
    imageAlt: 'captura do site coisas bonitas',
  },
  {
    id: 'ambi-mixer',
    title: 'Ambi Mixer',
    tagline: t('projects.ambi.tagline'),
    desc: t('projects.ambi.desc'),
    tags: ['Astro', 'TypeScript', 'Vercel', 'Audio UI'],
    status: 'in-progress',
    color: 'terracotta',
    image: '/projects/ambi-mixer-thumb.webp',
    fallbackImage: '/projects/ambi-studio-placeholder.svg',
    imageAlt: 'captura do ambi mixer em funcionamento',
  },
  {
    id: 'dither-tool',
    title: 'Dither Studio',
    tagline: t('projects.dither.tagline'),
    desc: t('projects.dither.desc'),
    tags: ['Rust', 'WebAssembly', 'Canvas'],
    status: 'live',
    color: 'purple',
    image: '/projects/dither-studio-thumb.webp',
    fallbackImage: '/projects/dither-studio-placeholder.svg',
    imageAlt: 'captura do dither studio',
  },
];

function resolvePublicAsset(assetPath: string, fallbackPath: string): string | null {
  if (existsSync(new URL(`../../public${assetPath}`, import.meta.url))) {
    return assetPath;
  }

  if (existsSync(new URL(`../../public${fallbackPath}`, import.meta.url))) {
    return fallbackPath;
  }

  return null;
}

const projectsWithAssets = projects.map((project) => ({
  ...project,
  resolvedImage: resolvePublicAsset(project.image, project.fallbackImage),
}));

const projectsById = Object.fromEntries(projectsWithAssets.map((project) => [project.id, project]));

function projectPreview(projectId: string, label: string): string {
  const project = projectsById[projectId];

  if (!project?.resolvedImage) {
    return `
      <div class="aspect-video rounded-2xl bg-brand-dark/5 dark:bg-white/5 flex items-center justify-center">
        <span class="text-brand-dark/30 dark:text-brand-light/30">${label}</span>
      </div>
    `;
  }

  return `
    <figure class="overflow-hidden rounded-2xl bg-brand-dark/5 dark:bg-white/5 border border-black/8 dark:border-brand-light/10">
      <img
        src="${project.resolvedImage}"
        alt="${project.imageAlt}"
        class="w-full aspect-video object-cover"
        loading="lazy"
      />
    </figure>
  `;
}

const statusConfig: Record<ProjectStatus, { label: string; class: string }> = {
  'live': { label: t('projects.status.live'), class: 'bg-green-500/20 text-green-600 dark:text-green-400' },
  'in-progress': { label: t('projects.status.progress'), class: 'bg-yellow-500/20 text-yellow-600 dark:text-yellow-400' },
  'planned': { label: t('projects.status.planned'), class: 'bg-brand-purple/20 text-brand-purple' },
};

const colorConfig: Record<string, string> = {
  purple: 'from-brand-purple/12 to-transparent',
  terracotta: 'from-brand-terracotta/12 to-transparent',
  green: 'from-brand-green/12 to-transparent',
};

const CARD_TAG_LIMIT = 3;
const MOBILE_TAG_LIMIT = 2;

const rijiStack = ['Vite', 'TypeScript', 'Tailwind', 'Supabase', 'Vercel'];
const ambiStack = ['Astro', 'TypeScript', 'Vercel', 'Audio UI'];
const projectModals: Record<string, { title: string; content: string }> = {
  'riji': {
    title: '日记 Riji',
    content: `
      <div class="space-y-6">
        <p class="text-lg text-brand-dark/80 dark:text-brand-light/80">
          ${t('projects.riji.modal.intro')}
        </p>
        ${projectPreview('riji', t('projects.modal.preview'))}
        <a
          href="https://rijiapp.site"
          target="_blank"
          class="inline-flex items-center gap-2 text-sm font-medium text-brand-purple hover:text-brand-terracotta transition-colors duration-300 lowercase"
        >
          ${t('projects.riji.linkLabel')}
          <span aria-hidden="true">↗</span>
        </a>
        <h3 class="font-bold text-lg text-brand-dark dark:text-brand-light">${t('projects.riji.modal.featuresTitle')}</h3>
        <ul class="list-disc list-inside space-y-2 text-brand-dark/70 dark:text-brand-light/70">
          <li>${t('projects.riji.feature.1')}</li>
          <li>${t('projects.riji.feature.2')}</li>
          <li>${t('projects.riji.feature.3')}</li>
          <li>${t('projects.riji.feature.4')}</li>
          <li>${t('projects.riji.feature.5')}</li>
          <li>${t('projects.riji.feature.6')}</li>
        </ul>
        <h3 class="font-bold text-lg text-brand-dark dark:text-brand-light">${t('projects.riji.modal.stackTitle')}</h3>
        <div class="flex flex-wrap gap-2">
          ${rijiStack.map((tag) => `
            <span class="text-[11px] uppercase tracking-wider font-mono text-brand-dark/40 dark:text-brand-light/40 bg-black/5 dark:bg-white/5 px-2.5 py-1 rounded-lg">${tag}</span>
          `).join('')}
        </div>
        <h3 class="font-bold text-lg text-brand-dark dark:text-brand-light">${t('projects.riji.modal.archTitle')}</h3>
        <ul class="list-disc list-inside space-y-2 text-brand-dark/70 dark:text-brand-light/70">
          <li>${t('projects.riji.arch.1')}</li>
          <li>${t('projects.riji.arch.2')}</li>
          <li>${t('projects.riji.arch.3')}</li>
          <li>${t('projects.riji.arch.4')}</li>
        </ul>
      </div>
    `
  },
  'coisas-bonitas': {
    title: 'Coisas Bonitas',
    content: `
      <div class="space-y-6">
        <p class="text-lg text-brand-dark/80 dark:text-brand-light/80">
          ${t('projects.coisas.modal.intro')}
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <a href="https://coisasbonitas.neocities.org" target="_blank" class="p-4 rounded-2xl glass-subtle hover:border-white/45 dark:hover:border-white/18 transition-colors">
            <span class="text-sm text-brand-dark/70 dark:text-brand-light/70">${t('projects.coisas.link.site')}</span>
          </a>
          <a href="https://soundcloud.com/coisasbonitas" target="_blank" class="p-4 rounded-2xl glass-subtle hover:border-white/45 dark:hover:border-white/18 transition-colors">
            <span class="text-sm text-brand-dark/70 dark:text-brand-light/70">${t('projects.coisas.link.soundcloud')}</span>
          </a>
          <a href="https://hkcr.live" target="_blank" class="p-4 rounded-2xl glass-subtle hover:border-white/45 dark:hover:border-white/18 transition-colors">
            <span class="text-sm text-brand-dark/70 dark:text-brand-light/70">${t('projects.coisas.link.hkcr')}</span>
          </a>
        </div>
        ${projectPreview('coisas-bonitas', t('projects.modal.published'))}
        <h3 class="font-bold text-lg text-brand-dark dark:text-brand-light">${t('projects.coisas.modal.structureTitle')}</h3>
        <ul class="list-disc list-inside space-y-2 text-brand-dark/70 dark:text-brand-light/70">
          <li>${t('projects.coisas.structure.1')}</li>
          <li>${t('projects.coisas.structure.2')}</li>
          <li>${t('projects.coisas.structure.3')}</li>
        </ul>
      </div>
    `
  },
  'ambi-mixer': {
    title: 'Ambi Mixer',
    content: `
      <div class="space-y-6">
        <p class="text-lg text-brand-dark/80 dark:text-brand-light/80">
          ${t('projects.ambi.modal.intro')}
        </p>
        ${projectPreview('ambi-mixer', t('projects.modal.preview'))}
        <a href="https://ambi-mixer.vercel.app/" target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 text-sm font-medium text-brand-terracotta hover:text-brand-purple transition-colors duration-300 lowercase">
          ${t('projects.ambi.linkLabel')} <span aria-hidden="true">↗</span>
        </a>
        <h3 class="font-bold text-lg text-brand-dark dark:text-brand-light">${t('projects.ambi.modal.featuresTitle')}</h3>
        <ul class="list-disc list-inside space-y-2 text-brand-dark/70 dark:text-brand-light/70">
          <li>${t('projects.ambi.feature.1')}</li>
          <li>${t('projects.ambi.feature.2')}</li>
          <li>${t('projects.ambi.feature.3')}</li>
          <li>${t('projects.ambi.feature.4')}</li>
        </ul>
        <h3 class="font-bold text-lg text-brand-dark dark:text-brand-light">${t('projects.ambi.modal.stackTitle')}</h3>
        <div class="flex flex-wrap gap-2">
          ${ambiStack.map((tag) => `
            <span class="text-[11px] uppercase tracking-wider font-mono text-brand-dark/40 dark:text-brand-light/40 bg-black/5 dark:bg-white/5 px-2.5 py-1 rounded-lg">${tag}</span>
          `).join('')}
