---

<section id="projects" class="w-full max-w-[1400px] mx-auto px-6 md:px-12 py-16 md:py-32 relative">
  
  <!-- Section Header -->
  <div class="mb-10 md:mb-20 flex flex-col md:flex-row md:items-end justify-between gap-4 reveal">
    <h2 class="font-display font-bold text-4xl md:text-5xl text-brand-dark dark:text-brand-light tracking-tight lowercase" data-section-title>
      {t('nav.projects')}<span class="text-brand-purple">.</span>
    </h2>
    <div class="h-px bg-brand-dark/10 dark:bg-brand-light/10 flex-1 ml-6 mb-2 hidden md:block"></div>
    <span class="text-xs font-mono uppercase tracking-widest text-brand-dark/50 dark:text-brand-light/50 mb-1.5 hidden md:block">
      {t('projects.sectionLabel')}
    </span>
  </div>

  <div class="md:hidden -mx-6 pl-6 pr-6 overflow-x-auto [scrollbar-width:none] [-ms-overflow-style:none] mobile-projects-strip">
    <div class="flex gap-4 snap-x snap-mandatory pb-2">
      {projectsWithAssets.map((project) => (
        <button
          type="button"
          data-project={project.id}
          aria-haspopup="dialog"
          aria-controls="project-modal"
          aria-label={`${t('projects.details')}: ${project.title}`}
          class="project-card group snap-start shrink-0 w-[82vw] max-w-[340px] rounded-[2rem] surface overflow-hidden text-left"
        >
          <div class={`h-44 relative overflow-hidden bg-gradient-to-br ${colorConfig[project.color]}`}>
            {project.resolvedImage ? (
              <img
                src={project.resolvedImage}
                alt={project.imageAlt}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            ) : null}
            <div class="absolute inset-0 bg-linear-to-t from-black/18 via-transparent to-transparent"></div>
          </div>

          <div class="p-5 space-y-4">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <h3 class="font-display font-bold text-2xl tracking-tight text-brand-dark dark:text-brand-light lowercase">
                  {project.title}
                </h3>
                <p class="text-sm text-brand-dark/52 dark:text-brand-light/52 lowercase truncate">
                  {project.tagline}
                </p>
              </div>
              <span class={`shrink-0 px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wide ${statusConfig[project.status].class}`}>
                {statusConfig[project.status].label}
              </span>
            </div>

            <p class="text-sm leading-relaxed text-brand-dark/72 dark:text-brand-light/72 line-clamp-2">
              {project.desc}
            </p>

            <div class="flex flex-nowrap items-center gap-2 overflow-hidden whitespace-nowrap min-w-0">
              {project.tags.slice(0, MOBILE_TAG_LIMIT).map((tag) => (
              <span class="inline-flex shrink-0 text-[11px] uppercase tracking-wider font-mono text-brand-dark/45 dark:text-brand-light/40 bg-black/[0.045] dark:bg-white/5 px-2.5 py-1 rounded-lg">
                  {tag}
                </span>
              ))}
              {project.tags.length > MOBILE_TAG_LIMIT && (
                <span class="shrink-0 text-[11px] uppercase tracking-wider font-mono text-brand-purple bg-brand-purple/10 px-2.5 py-1 rounded-lg">
                  +{project.tags.length - MOBILE_TAG_LIMIT}
                </span>
              )}
            </div>

            <div class="inline-flex items-center gap-2 text-sm font-medium text-brand-purple">
              <span>{t('projects.details')}</span>
              <Icon name="ph:arrow-right-bold" class="w-4 h-4" />
            </div>
          </div>
        </button>
      ))}
    </div>
  </div>

  <!-- Projects Grid -->
  <div class="hidden md:grid grid-cols-1 md:grid-cols-2 gap-6">
    {projectsWithAssets.map((project, index) => (
      <button 
        type="button"
        data-project={project.id}
        aria-haspopup="dialog"
        aria-controls="project-modal"
        aria-label={`${t('projects.details')}: ${project.title}`}
        class={`project-card group relative p-0 rounded-3xl surface text-left overflow-hidden reveal reveal-delay-${(index + 1) * 100} cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple/50 md:h-[240px]`}
        style="transition: transform 800ms cubic-bezier(0.19, 1, 0.22, 1), box-shadow 800ms cubic-bezier(0.19, 1, 0.22, 1), border-color 600ms ease;"
        onmouseenter="this.style.transform = 'translateY(-4px)'; this.style.borderColor = 'rgba(176, 102, 255, 0.3)';"
        onmouseleave="this.style.transform = 'translateY(0)'; this.style.borderColor = '';"
      >
        <!-- Gradient Background on Hover -->
        <div class={`absolute inset-0 bg-gradient-to-br ${colorConfig[project.color]} opacity-0 group-hover:opacity-70 transition-opacity duration-700 pointer-events-none`}></div>
        
        <!-- Content -->
        <div class="relative z-10 flex flex-col md:grid md:grid-cols-[240px_minmax(0,1fr)] h-full">
          <div class="w-full md:w-[240px] shrink-0 overflow-hidden bg-black/[0.04] dark:bg-white/5 aspect-square md:aspect-square md:h-full border-b md:border-b-0 md:border-r border-black/8 dark:border-brand-light/10">
            <div class="w-full h-full">
              {project.resolvedImage ? (
                <img
                  src={project.resolvedImage}
                  alt={project.imageAlt}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-xs uppercase tracking-wider text-brand-dark/40 dark:text-brand-light/40 font-mono">
                  {t('projects.modal.preview')}
                </div>
              )}
            </div>
          </div>

          <div class="min-w-0 h-full grid grid-rows-[auto_auto_1fr_auto] p-5 md:px-5 md:py-4">
            <div class="flex items-start justify-between gap-4 mb-3">
              <div>
                <h3 class="font-display font-bold text-xl md:text-2xl text-brand-dark dark:text-brand-light group-hover:text-brand-purple transition-colors duration-300 lowercase">
                  {project.title}
                </h3>
                <span class="text-sm text-brand-dark/50 dark:text-brand-light/50 lowercase">
                  {project.tagline}
                </span>
              </div>
              <span class={`px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wide ${statusConfig[project.status].class}`}>
                {statusConfig[project.status].label}
              </span>
            </div>

            <p class="text-base text-brand-dark/70 dark:text-brand-light/70 leading-relaxed mb-4 max-w-[40ch]">
              {project.desc}
            </p>

            <div class="flex flex-nowrap items-center gap-2 overflow-hidden whitespace-nowrap min-w-0">
              {project.tags.slice(0, CARD_TAG_LIMIT).map((tag) => (
                <span class="inline-flex shrink-0 text-[11px] uppercase tracking-wider font-mono text-brand-dark/45 dark:text-brand-light/40 bg-black/[0.045] dark:bg-white/5 px-2.5 py-1 rounded-lg">
                  {tag}
                </span>
              ))}
              {project.tags.length > CARD_TAG_LIMIT && (
                <span class="shrink-0 text-[11px] uppercase tracking-wider font-mono text-brand-purple bg-brand-purple/10 px-2.5 py-1 rounded-lg">
                  +{project.tags.length - CARD_TAG_LIMIT}
                </span>
              )}
            </div>

            <div class="pt-4 flex items-center gap-2 text-sm font-medium text-brand-purple opacity-70 md:opacity-0 translate-y-1 transition-all duration-300 lowercase group-hover:opacity-100 group-hover:translate-y-0">
              <span>{t('projects.details')}</span>
              <Icon name="ph:arrow-right-bold" class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" />
            </div>
          </div>
        </div>
        
        <!-- Corner Decoration -->
        <div class="absolute -bottom-8 -right-8 w-32 h-32 bg-brand-purple/5 rounded-full blur-2xl opacity-0 group-hover:opacity-40 transition-opacity duration-700"></div>
      </button>
    ))}
  </div>

  <!-- GitHub Link -->
  <div class="text-center mt-12 reveal">
    <a 
      href="https://github.com/rugo-cafe" 
      target="_blank"
      class="inline-flex items-center gap-2 text-sm text-brand-dark/50 dark:text-brand-light/50 hover:text-brand-purple transition-colors duration-300 lowercase"
    >
      <Icon name="simple-icons:github" class="w-4 h-4" />
      <span>{t('projects.github.more')}</span>
      <Icon name="ph:arrow-up-right-bold" class="w-3 h-3" />
    </a>
  </div>

</section>

<style is:global>
  .mobile-projects-strip::-webkit-scrollbar {
    display: none;
  }
</style>

<!-- Project Detail Modal -->
<dialog 
  id="project-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
  aria-describedby="modal-content"
  class="fixed inset-0 m-auto p-0 w-[90vw] max-w-4xl max-h-[85vh] overflow-hidden glass-strong rounded-3xl shadow-[0_30px_80px_-42px_rgba(39,35,42,0.34)]"
>
  <div class="sticky top-0 z-10 flex items-center justify-between px-8 py-5 border-b border-black/8 dark:border-brand-light/5 glass-subtle">
    <h2 id="modal-title" class="font-display font-bold text-2xl text-brand-dark dark:text-brand-light"></h2>
    <button 
      type="button"
      id="modal-close"
      aria-label={t('projects.modal.close')}
      class="flex items-center justify-center w-10 h-10 rounded-full glass-subtle hover:border-white/45 dark:hover:border-white/18 transition-colors cursor-pointer"
    >
      <Icon name="ph:x-bold" class="w-5 h-5 text-brand-dark/60 dark:text-brand-light/60" />
    </button>
  </div>
  
  <div id="modal-content" class="p-8 overflow-y-auto" style="max-height: calc(85vh - 80px);">
    <!-- Content injected via JS -->
  </div>
</dialog>

<div id="project-modal-backdrop" class="fixed inset-0 z-40 glass-backdrop pointer-events-none"></div>

<script is:inline define:vars={{ projectModals }}>
  document.addEventListener('astro:page-load', () => {
    const modal = document.getElementById('project-modal');
    const backdrop = document.getElementById('project-modal-backdrop');
    const closeBtn = document.getElementById('modal-close');
    const modalTitle = document.getElementById('modal-title');
    const modalContent = document.getElementById('modal-content');

    if (!modal || !backdrop || !modalTitle || !modalContent) return;

    if (modal.dataset.controllerBound === 'true') return;
    modal.dataset.controllerBound = 'true';
    modal.setAttribute('aria-hidden', 'true');

    const abortController = new AbortController();
    const { signal } = abortController;

    const projects = projectModals;
    let activeTrigger = null;
    let isOpen = false;
    let closeTimer = null;
    let lockedScrollY = 0;
    const animationMs = 320;

    function getFocusableElements() {
      const selector = 'a[href], button:not([disabled]), textarea:not([disabled]), input:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])';
      return Array.from(modal.querySelectorAll(selector)).filter((el) => {
        return !(el.hasAttribute('hidden') || el.getAttribute('aria-hidden') === 'true');
      });
    }

    function lockPageScroll() {
      lockedScrollY = window.scrollY || document.documentElement.scrollTop || 0;
      const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;

      document.body.style.position = 'fixed';
      document.body.style.top = `-${lockedScrollY}px`;
      document.body.style.left = '0';
      document.body.style.right = '0';
      document.body.style.width = '100%';
      document.body.style.overflow = 'hidden';

      if (scrollbarWidth > 0) {
        document.body.style.paddingRight = `${scrollbarWidth}px`;
      }
    }

    function unlockPageScroll() {
      const root = document.documentElement;
      const previousScrollBehavior = root.style.scrollBehavior;

      root.style.scrollBehavior = 'auto';
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.left = '';
      document.body.style.right = '';
      document.body.style.width = '';
      document.body.style.overflow = '';
      document.body.style.paddingRight = '';

      window.scrollTo(0, lockedScrollY);
      root.style.scrollBehavior = previousScrollBehavior;
    }

    function setModalState(state) {
      modal.dataset.state = state;
      backdrop.dataset.state = state;
    }

    function openModal(projectId, triggerEl) {
      const project = projects[projectId];
      if (!project) return;

      if (closeTimer) {
        window.clearTimeout(closeTimer);
        closeTimer = null;
      }

      activeTrigger = triggerEl || null;
      
      modalTitle.textContent = project.title;
      modalContent.innerHTML = project.content;
      modalContent.scrollTop = 0;

      if (modal.open && typeof modal.close === 'function') {
        modal.close();
      }

      lockPageScroll();

      if (typeof modal.showModal === 'function') {
        try {
          modal.showModal();
        } catch {
          modal.setAttribute('open', '');
        }
      } else {
        modal.setAttribute('open', '');
      }

      isOpen = true;
      modal.removeAttribute('aria-hidden');
      setModalState('opening');

      requestAnimationFrame(() => {
        setModalState('open');
        const focusables = getFocusableElements();
        const first = focusables[0] || closeBtn || modal;
        if (first && typeof first.focus === 'function') {
          first.focus({ preventScroll: true });
        }
      });
    }

    function closeModal(restoreFocus = true, immediate = false) {
      if (!isOpen) return;

      isOpen = false;
      modal.setAttribute('aria-hidden', 'true');
      setModalState('closing');

      const finishClose = () => {
        if (typeof modal.close === 'function') {
          modal.close();
        } else {
          modal.removeAttribute('open');
        }

        setModalState('closed');
        unlockPageScroll();

        if (restoreFocus && activeTrigger && typeof activeTrigger.focus === 'function') {
          requestAnimationFrame(() => activeTrigger.focus({ preventScroll: true }));
        }
        activeTrigger = null;
        closeTimer = null;
      };

      if (immediate) {
        finishClose();
        return;
      }

      closeTimer = window.setTimeout(finishClose, animationMs);
    }

    const cards = document.querySelectorAll('.project-card[data-project]');
    cards.forEach((card) => {
      card.addEventListener('click', () => {
      const projectId = card.dataset.project;
      if (projectId) openModal(projectId, card);
      }, { signal });
    });

    if (closeBtn) closeBtn.addEventListener('click', () => closeModal(true), { signal });
    if (backdrop) backdrop.addEventListener('click', () => closeModal(true), { signal });

    modal.addEventListener('cancel', (e) => {
      e.preventDefault();
      closeModal(true);
    }, { signal });
    
    modal.addEventListener('keydown', (e) => {
      if (!isOpen) return;

      if (e.key === 'Escape') {
        e.preventDefault();
        closeModal(true);
      }

      if (e.key === 'Tab') {
        const focusables = getFocusableElements();
        if (!focusables.length) {
          e.preventDefault();
          return;
        }

        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        const active = document.activeElement;

        if (e.shiftKey && active === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && active === last) {
          e.preventDefault();
          first.focus();
        }
      }
    }, { signal });

    document.addEventListener('astro:before-swap', () => {
      closeModal(false, true);
      abortController.abort();
      delete modal.dataset.controllerBound;
    }, { once: true, signal });
  });
</script>

