---
import { useTranslations } from '../i18n/utils';
import SectionHeading from './SectionHeading.astro';
interface Props { lang: string }
const { lang } = Astro.props;
const t = useTranslations(lang as any);
const isPt = lang === 'pt';
---
<section id="about" class="container section-space" aria-labelledby="about-heading">
  <SectionHeading id="about-heading" index="02 /" title={t('nav.about')} aside={isPt ? 'processo, prática e interesses' : 'process, practice and interests'} />
  <div class="about-grid">
    <figure class="portrait" data-animate>
      <img src="/avatar/vitor-hugo-avatar.webp" alt={isPt ? 'retrato de vitor hugo cunha' : 'portrait of vitor hugo cunha'} loading="lazy" decoding="async" width="800" height="800" />
      <figcaption class="meta-label">vitor hugo cunha / florianópolis</figcaption>
    </figure>
    <div class="about-copy">
      <p class="about-lead" data-animate>{t('about.intro.1')}</p>
      <p data-animate>{t('about.intro.2')}</p>
      <p data-animate>{t('about.intro.3')}</p>
      <div class="about-links" data-animate>
        <a class="text-link" href="mailto:contato@vitorhugocunha.com">{t('about.cta.contact')} ↗</a>
        <a class="text-link" href="https://www.linkedin.com/in/vitor-hugo-cunha/" target="_blank" rel="noopener noreferrer">{t('about.cta.linkedin')} ↗</a>
      </div>
    </div>
  </div>
</section>
<style>
  .about-grid { display: grid; grid-template-columns: minmax(12rem, .7fr) minmax(0, 1.3fr); gap: clamp(2rem, 10vw, 10rem); align-items: start; padding-top: clamp(2rem, 5vw, 5rem); }
  .portrait { max-width: 24rem; }
  .portrait img { aspect-ratio: 4 / 5; width: 100%; object-fit: cover; object-position: center top; filter: saturate(.78); }
  .portrait figcaption { padding-top: .9rem; }
  .about-copy { max-width: 56ch; display: grid; gap: 1.5rem; }
  .about-copy p { font-size: clamp(.98rem, 1.2vw, 1.13rem); line-height: 1.72; color: var(--muted); }
  .about-copy .about-lead { font-size: clamp(1.35rem, 2.25vw, 2rem); font-weight: 500; letter-spacing: -.035em; line-height: 1.3; color: var(--text); }
  .about-links { display: flex; flex-wrap: wrap; gap: 1.5rem; margin-top: .65rem; font-size: .88rem; }
  @media (max-width: 720px) { .about-grid { grid-template-columns: 1fr; gap: 2rem; } .portrait { width: min(64vw, 22rem); } }
</style>