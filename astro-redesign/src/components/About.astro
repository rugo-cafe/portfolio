---
import { Icon } from 'astro-icon/components';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang as any);

const avatarSrc = '/avatar/vitor-hugo-avatar.webp';
const avatarAlt = 'retrato de vitor hugo cunha';
---

<section id="about" class="w-full max-w-[1400px] mx-auto px-6 md:px-12 py-16 md:py-32 relative">
  
  <!-- Section Header -->
  <div class="mb-10 md:mb-20 flex flex-col md:flex-row md:items-end justify-between gap-4 reveal">
    <h2 class="font-display font-bold text-4xl md:text-5xl text-brand-dark dark:text-brand-light tracking-tight lowercase" data-section-title>
      {t('nav.about')}<span class="text-brand-purple">.</span>
    </h2>
    <div class="h-px bg-brand-dark/10 dark:bg-brand-light/10 flex-1 ml-6 mb-2 hidden md:block"></div>
  </div>

  <!-- Main Content Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
    
    <!-- Photo Column -->
    <div class="lg:col-span-4 reveal reveal-delay-100 pb-10 md:pb-0">
      <div class="relative">
        <!-- Photo Container -->
        <div class="aspect-square rounded-3xl overflow-hidden glass-strong flex items-center justify-center">
          <img
            src={avatarSrc}
            alt={avatarAlt}
            class="w-full h-full object-cover object-top origin-top scale-[1.08]"
            loading="lazy"
            decoding="async"
          />
        </div>
        
        <!-- Decorative Elements -->
        <div class="absolute -bottom-4 -right-4 w-24 h-24 bg-brand-purple/10 rounded-full blur-2xl" data-parallax="0.3"></div>
        <div class="absolute -top-4 -left-4 w-16 h-16 bg-brand-terracotta/10 rounded-full blur-xl" data-parallax="0.5"></div>
        
        <!-- Floating Badge -->
        <div class="absolute bottom-4 md:-bottom-3 left-4 right-4 md:left-6 md:right-6 p-3 md:p-4 rounded-2xl glass-subtle shadow-[0_20px_40px_-28px_rgba(39,35,42,0.28)] dark:shadow-lg">
          <div class="flex w-full md:w-auto items-center justify-center md:justify-start gap-3 text-center md:text-left">
            <div class="relative">
              <span class="flex h-3 w-3">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-500 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
              </span>
            </div>
            <span class="text-[13px] md:text-sm font-medium text-brand-dark dark:text-brand-light">
              {t('work.status')}
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Text Column -->
    <div class="lg:col-span-8 space-y-10">
      
      <!-- Intro -->
      <div class="space-y-6 max-w-xl reveal reveal-delay-200">
        <p class="text-xl md:text-2xl leading-relaxed text-white font-semibold">
          {t('about.intro.1')}
        </p>
        <p class="text-base md:text-lg leading-relaxed text-zinc-400">
          {t('about.intro.2')}
        </p>
        <p class="text-base md:text-lg leading-relaxed text-zinc-400">
          {t('about.intro.3')}
        </p>
      </div>

      <!-- CTA -->
      <div class="mt-8 flex flex-col sm:flex-row gap-4 reveal reveal-delay-500">
        <a 
          href="mailto:contato@vitorhugocunha.com" 
          class="group inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-brand-purple text-white font-medium hover:bg-brand-purple/90 hover:scale-105 hover:shadow-lg hover:shadow-brand-purple/30 transition-all duration-300 lowercase"
        >
          <Icon name="ph:envelope-simple-bold" class="w-4 h-4 group-hover:scale-110 transition-transform duration-300" />
          <span>{t('about.cta.contact')}</span>
        </a>
        <a 
          href="https://www.linkedin.com/in/vitor-hugo-cunha/"
          target="_blank"
          rel="noreferrer"
          class="group inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full surface-muted text-brand-dark dark:text-brand-light font-medium hover:scale-105 hover:border-brand-purple/30 transition-all duration-300"
        >
          <Icon name="simple-icons:linkedin" class="w-4 h-4 group-hover:scale-110 transition-transform duration-300" />
          <span>{t('about.cta.linkedin')}</span>
        </a>
      </div>

    </div>
  </div>

</section>
