---
interface Props { lang: string }
const { lang } = Astro.props;
const pt = lang === 'pt';
const content = pt ? {
  label: 'sobre',
  heading: 'sobre',
  first: 'estudo design de produto na ufsc e trabalho com interfaces, desenvolvimento web e automações.',
  second: 'também faço música como rugo e apresento o coisas bonitas na hkcr.',
  listen: 'coisas bonitas',
} : {
  label: 'about',
  heading: 'about',
  first: 'i study product design at ufsc and work with interfaces, web development and automation.',
  second: 'i also make music as rugo and host coisas bonitas on hkcr.',
  listen: 'coisas bonitas',
};
---
<section id="about" class="container about" aria-labelledby="about-heading">
  <div class="about-label"><span class="marker">✳</span><span class="small">{content.label}</span></div>
  <div class="about-main">
    <div>
      <h2 id="about-heading">{content.heading}</h2>
      <p>{content.first}</p>
      <p>{content.second}</p>
      <a class="listen" href="https://coisasbonitas.neocities.org/" target="_blank" rel="noopener noreferrer">{content.listen} ↗</a>
    </div>

  </div>
</section>
<style>
  .about { padding-block: clamp(5rem, 12vw, 12rem); display: grid; grid-template-columns: 1fr 5fr; gap: clamp(1rem, 5vw, 5rem); }
  .about-label { display: flex; flex-direction: column; gap: 1.5rem; color: var(--accent); }
  .marker { display: block; font-size: 2.25rem; line-height: 1; }
  .small { font: .73rem/1.5 var(--font-mono); color: var(--muted); }
  .about-main { max-width: 50rem; }
  h2 { font: 400 clamp(1.7rem, 3vw, 3rem)/1.12 var(--font-display); letter-spacing: -.05em; margin-bottom: 2rem; max-width: 20ch; }
  .about-main p { font-size: clamp(.98rem, 1.2vw, 1.15rem); max-width: 56ch; line-height: 1.7; margin-top: 1.25rem; }
  .about-main .lead { font-size: clamp(1.2rem, 1.8vw, 1.65rem); max-width: 35ch; line-height: 1.45; letter-spacing: -.02em; }
  .listen { display: inline-block; text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: .25rem; margin-top: 2rem; font-size: .9rem; }
  .listen:hover { color: var(--accent); }
  .margin-note { color: var(--muted); padding-bottom: 2rem; transform: rotate(-2deg); max-width: 22ch; }
  .margin-note p { font: .86rem/1.65 var(--font-mono); }
  .signature { display: block; margin-top: .8rem; font: .76rem var(--font-mono); }
  .note-line { color: var(--accent); font-size: 1.8rem; }
  @media(max-width:900px){.about{grid-template-columns:1fr}.about-label{flex-direction:row;align-items:center}.about-main{grid-template-columns:minmax(0, 1fr) minmax(9rem,.4fr)}}
  @media(max-width:600px){.about-main{grid-template-columns:1fr}.margin-note{margin-left:auto;max-width:29ch;padding-bottom:0}}
  @media(prefers-reduced-motion: reduce){.margin-note{transform:none}}
</style>