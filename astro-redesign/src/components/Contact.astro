---
interface Props { lang: string }
const { lang } = Astro.props;
const pt = lang === 'pt';
const home = pt ? '/' : '/en';
---
<footer id="contact" class="contact-footer container" aria-labelledby="contact-heading">
  <div class="footer-top" data-animate>
    <span class="meta-label">04 / {pt ? 'contato' : 'contact'}</span>
    <div>
      <h2 id="contact-heading">{pt ? 'tem algo em mente?' : 'have something in mind?'}</h2>
      <a class="email" href="mailto:contato@vitorhugocunha.com">contato@vitorhugocunha.com <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <div class="footer-bottom">
    <span class="meta-label">© {new Date().getFullYear()} vitor hugo cunha</span>
    <nav aria-label={pt ? 'links externos' : 'external links'}>
      <a href="https://github.com/rugo-cafe" target="_blank" rel="noopener noreferrer">github ↗</a>
      <a href="https://www.linkedin.com/in/vitor-hugo-cunha/" target="_blank" rel="noopener noreferrer">linkedin ↗</a>
      <a href={home + '#home'}>{pt ? 'voltar ao início ↑' : 'back to top ↑'}</a>
    </nav>
  </div>
</footer>
<style>
  .contact-footer { padding-block: clamp(4rem, 8vw, 8rem) 1.5rem; }
  .footer-top { border-top: 1px solid var(--border); padding-top: 1.5rem; display: grid; grid-template-columns: minmax(9rem, 1fr) minmax(0, 3fr); gap: 2rem; }
  h2 { font: 500 clamp(1.75rem, 3.7vw, 3.5rem)/1.1 var(--font-display); letter-spacing: -.045em; }
  .email { display: inline-flex; align-items: baseline; gap: 1rem; margin-top: 2rem; font-size: clamp(.95rem, 1.8vw, 1.4rem); border-bottom: 1px solid var(--text); padding-bottom: .3rem; text-decoration: none; overflow-wrap: anywhere; }
  .email:hover, .footer-bottom a:hover { color: var(--accent); }
  .footer-bottom { display: flex; justify-content: space-between; align-items: end; gap: 2rem; margin-top: clamp(4rem, 9vw, 8rem); padding-top: 1rem; border-top: 1px solid var(--border); }
  .footer-bottom nav { display: flex; gap: 1.5rem; flex-wrap: wrap; }
  .footer-bottom a { font-size: .78rem; text-decoration: none; }
  @media(max-width:700px){.footer-top{grid-template-columns:1fr;gap:1.5rem}.footer-bottom{align-items:start;flex-direction:column}}
</style>