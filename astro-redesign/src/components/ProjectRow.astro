---
import type { ProjectEntry } from '../data/projects';
interface Props { project: ProjectEntry; index: number; lang: string }
const { project, index, lang } = Astro.props;
const url = lang === 'pt' ? '/projects/' + project.slug : '/' + lang + '/projects/' + project.slug;
const statuses = lang === 'pt'
  ? { live: 'publicado', 'in-progress': 'em andamento', planned: 'planejado' }
  : { live: 'live', 'in-progress': 'in progress', planned: 'planned' };
---
<li class="project-row" data-animate data-delay={Math.min(180, index * 45)}>
  <a class="project-link" href={url} data-project={project.slug} aria-label={(lang === 'pt' ? 'ver projeto: ' : 'view project: ') + project.title}>
    <span class="project-no">{String(index + 1).padStart(2, '0')}</span>
    <span class="project-information">
      <span class="project-name">{project.title}</span>
      <span class="project-subtitle">{project.subtitle}</span>
      {project.resolvedImage && (
        <span class="project-image">
          <img src={project.resolvedImage} alt={project.imageAlt} width="860" height="560" loading="lazy" decoding="async" />
        </span>
      )}
    </span>
    <span class="project-status">{statuses[project.status]}</span>
    <span class="project-arrow" aria-hidden="true">↗</span>
  </a>
</li>
<style>
  .project-row { border-bottom: 1px solid var(--border); }
  .project-link { display: grid; grid-template-columns: 2.25rem minmax(0, 1fr) 6.5rem 1.25rem; gap: clamp(.6rem, 2vw, 1.5rem); align-items: start; padding: 1.65rem .25rem; color: var(--text); text-decoration: none; transition: color var(--speed-fast) ease; }
  .project-link:hover, .project-link:focus-visible { color: var(--accent); }
  .project-no, .project-status { font: .69rem/1.5 var(--font-mono); color: var(--muted); padding-top: .38rem; }
  .project-status { text-align: right; }
  .project-name { display: block; font: 500 clamp(1.4rem, 2.2vw, 2.25rem)/1.18 var(--font-display); letter-spacing: -.045em; transition: transform var(--speed-medium) var(--ease-out); }
  .project-link:hover .project-name, .project-link:focus-visible .project-name { transform: translateX(.25rem); }
  .project-subtitle { display: block; font-size: .83rem; line-height: 1.45; margin-top: .4rem; color: var(--muted); }
  .project-arrow { font-size: 1.1rem; text-align: right; line-height: 1.4; transition: transform var(--speed-medium) var(--ease-out); }
  .project-link:hover .project-arrow, .project-link:focus-visible .project-arrow { transform: translate(.15rem, -.15rem); }
  .project-image { display: none; margin-top: 1.1rem; overflow: hidden; background: var(--surface); }
  .project-image img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; }
  @media(max-width:850px){
    .project-link { grid-template-columns: 2rem minmax(0, 1fr) 1.4rem; padding: 1.45rem 0 1.8rem; }
    .project-status { display: none; }
    .project-image { display: block; }
  }
  @media(prefers-reduced-motion:reduce){.project-name,.project-arrow{transition:none}}
</style>